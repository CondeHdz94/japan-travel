---
import Base from '../layouts/Base.astro';
import { SEMILLAS } from '../data/lugares';
import { VENTANAS_VIAJE } from '../data/ventanas';

// Temperaturas medias de Tokio (°C, aprox.). Gente y precio: 1 bajo · 2 medio · 3 alto (orientativo).
const meses = [
  { m: 'Ene', lo: 2, hi: 10, gente: 1, precio: 1, tag: '雪', nota: 'Frío seco, nieve en el norte' },
  { m: 'Feb', lo: 2, hi: 10, gente: 1, precio: 1, tag: '梅', nota: 'Ciruelos, lo más barato' },
  { m: 'Mar', lo: 5, hi: 14, gente: 3, precio: 3, tag: '桜', nota: 'Empiezan los cerezos (fin de mes)' },
  { m: 'Abr', lo: 10, hi: 19, gente: 3, precio: 3, tag: '桜', nota: 'Cerezos + Golden Week al final' },
  { m: 'May', lo: 15, hi: 23, gente: 2, precio: 2, tag: '緑', nota: 'Verde y templado tras el 6 de mayo' },
  { m: 'Jun', lo: 19, hi: 26, gente: 1, precio: 1, tag: '梅雨', nota: 'Temporada de lluvias' },
  { m: 'Jul', lo: 23, hi: 30, gente: 2, precio: 2, tag: '祭', nota: 'Calor húmedo, festivales' },
  { m: 'Ago', lo: 24, hi: 31, gente: 3, precio: 3, tag: '台風', nota: 'Bochorno, Obon y tifones' },
  { m: 'Sep', lo: 21, hi: 27, gente: 1, precio: 1, tag: '台風', nota: 'Todavía tifones' },
  { m: 'Oct', lo: 15, hi: 22, gente: 2, precio: 2, tag: '秋', nota: 'Seco y fresco' },
  { m: 'Nov', lo: 9, hi: 17, gente: 3, precio: 2, tag: '紅葉', nota: 'Hojas rojas de otoño' },
  { m: 'Dic', lo: 4, hi: 12, gente: 2, precio: 2, tag: '灯', nota: 'Luces; Año Nuevo es caro' },
];
const MAX = 34;
const pct = (t: number) => (t / MAX) * 100;

// las seis ventanas (src/data/ventanas.ts): las mismas que resume Decisiones
const ventanas = VENTANAS_VIAJE;

// Qué hay de temporada en cada ventana: lugares y eventos del catálogo que solo se dan en esos
// meses (se dejan por fuera los que duran medio año, que no distinguen una ventana de otra).
// Abril tardío comparte mes con los cerezos: ahí se nombran a mano los que caen en esas fechas.
// Otoño llega al 7 de diciembre: de diciembre entra solo lo de los primeros días (`mas`).
const enVentana: Record<string, { meses: number[]; filtro: string; ids?: string[]; mas?: string[] }> = {
  cerezos: { meses: [3, 4], filtro: 'primavera' },
  abril: { meses: [4], filtro: 'primavera', ids: ['takayama-matsuri', 'kawachi-fujien', 'hitachi', 'ashikaga'] },
  primavera: { meses: [5, 6], filtro: 'primavera' },
  verano: { meses: [7, 8], filtro: 'verano' },
  otono: { meses: [10, 11], filtro: 'otono', mas: ['chichibu'] },
  invierno: { meses: [1, 2], filtro: 'invierno' },
};
const deTemporada = (id: string) => {
  const { meses, ids, mas = [] } = enVentana[id];
  if (ids) return ids.map((i) => SEMILLAS.find((l) => l.id === i)!);
  return SEMILLAS.filter(
    (l) =>
      l.meses && l.meses.length <= 4 && (l.meses.some((m) => meses.includes(m)) || mas.includes(l.id)),
  ).sort((a, b) => a.meses!.length - b.meses!.length); // primero lo más puntual
};

const opciones = [
  { v: 2, t: 'Me encanta', k: '好' },
  { v: 1, t: 'Me sirve', k: '可' },
  { v: 0, t: 'No puedo', k: '否' },
];

const evitar = [
  { q: 'Golden Week', d: '29 abr – 5 may', p: 'Todo Japón viaja al tiempo: trenes y hoteles agotados. En 2027 los festivos son el 29 de abril y del 3 al 5 de mayo.' },
  { q: 'Obon', d: '≈ 13 – 16 ago', p: 'Segundo pico de viajes internos, con el peor calor. No es festivo oficial: las fechas son las de costumbre.' },
  { q: 'Tsuyu (lluvias)', d: '≈ 7 jun – 19 jul', p: 'Promedio en Tokio y Kioto; algunos años se corre una o dos semanas. Llueve casi a diario.' },
  { q: 'Tifones', d: 'ago – sep', p: 'Los meses con más tifones cerca de Japón: riesgo de vuelos y trenes cancelados.' },
  { q: 'Año Nuevo', d: '29 dic – 3 ene', p: 'Las oficinas públicas cierran por ley y muchos sitios también; los precios se disparan.' },
];
---

<Base title="Cuándo ir" description="El año japonés mes a mes para escoger la fecha del viaje.">
  <header class="page-head">
    <span class="kanji" aria-hidden="true">時</span>
    <div>
      <span class="mono">01 · toki · el tiempo</span>
      <h1>Cuándo ir</h1>
      <p>
        La fecha decide el precio, el clima y las fotos. Este es el año japonés de un vistazo, y
        las ventanas que vale la pena discutir en el grupo para 15 días de viaje.
      </p>
    </div>
  </header>

  <section class="anio" aria-labelledby="anio-t">
    <div class="anio-head wrap">
      <h2 id="anio-t" class="mono">El año en Tokio</h2>
      <p class="mono leyenda">
        <span><i class="bar"></i> Rango de temperatura</span>
        <span><i class="dot on"></i> Gente</span>
        <span>¥ Precio</span>
      </p>
    </div>
    <div class="scroll">
      <ol class="meses">
        {
          meses.map((x) => (
            <li>
              <span class="tag" aria-hidden="true">{x.tag}</span>
              <div class="termo" role="img" aria-label={`${x.m}: entre ${x.lo} y ${x.hi} grados`}>
                <span
                  class="rango"
                  style={`bottom:${pct(x.lo)}%;height:${pct(x.hi - x.lo)}%`}
                >
                  <b class="mono">{x.hi}°</b>
                  <b class="mono">{x.lo}°</b>
                </span>
              </div>
              <strong>{x.m}</strong>
              <span class="dots" aria-label={`Gente: ${x.gente} de 3`}>
                {[1, 2, 3].map((i) => <i class:list={['dot', { on: i <= x.gente }]} />)}
              </span>
              <span class="mono yen" aria-label={`Precio: ${x.precio} de 3`}>
                {'¥'.repeat(x.precio)}
              </span>
              <span class="nota">{x.nota}</span>
              <div class="puedo" data-marca={`mes:${x.m.toLowerCase()}`}>
                <button type="button" class="poner" data-poner="1" aria-pressed="false">
                  Puedo
                </button>
                <span data-sellos></span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="wrap pie">
      <b>¿Cuándo puedes viajar?</b> Marca «Puedo» en cada mes en que te den vacaciones o permiso,
      sin pensar todavía en si te gusta o no.
    </p>
    <p class="wrap pie mono">
      Cali vive entre 19 y 30 °C todo el año: cualquier cosa por debajo de 10 °C nos va a parecer
      nevera.
    </p>
  </section>

  <section class="sec">
    <header>
      <span class="mono">Candidatas</span>
      <h2>Seis ventanas para votar</h2>
    </header>
    <div class="candidatas">
      <p class="invita">
        <span>Para votar y ver qué prefieren los demás,</span>
        <button type="button" data-entrar>entra con tu nombre →</button>
      </p>
      <div class="ventanas">
      {
        ventanas.map((v, n) => (
          <article>
            <div class="papel">
              <p class="tira">
                <span lang="ja">旅みくじ</span>
                <span class="mono">N.º {String(n + 1).padStart(2, '0')}</span>
              </p>
              <div class="cab">
                <div>
                  <h3>{v.nombre}</h3>
                  <span class="mono fechas">{v.fechas}</span>
                  <span class:list={['chip', v.estado]}>{v.etiqueta}</span>
                </div>
                <span class="estacion" lang="ja" title={v.dice} aria-label={v.dice}>
                  {v.kanji}
                </span>
              </div>
              <p class="oraculo">{v.veredicto}</p>
              <div class="lineas">
                <p><span lang="ja" aria-label="A favor">吉</span><span>{v.pro}</span></p>
                <p class="malo"><span lang="ja" aria-label="En contra">凶</span><span>{v.contra}</span></p>
              </div>
              {/* siempre está, aunque vacía: cada parte de la tarjeta ocupa su fila en la rejilla */}
              <p class="temporada">
                {deTemporada(v.id).length > 0 && (
                  <>
                    <span class="mono">Solo en estas fechas</span>
                    {deTemporada(v.id).slice(0, 4).map((l) => l.nombre).join(' · ')}
                    {deTemporada(v.id).length > 4 && ` y ${deTemporada(v.id).length - 4} más`}.{' '}
                    <a href={`/lugares?t=${enVentana[v.id].filtro}`}>Ver lugares →</a>
                  </>
                )}
              </p>
              <div class="pie-voto">
                <p class="mono titulo">Tu voto · <span lang="ja">投票</span></p>
                <ul class="voto" data-marca={`ventana:${v.id}`} aria-label={`Tu voto: ${v.nombre}`}>
                  {
                    opciones.map((o) => (
                      <li>
                        <button type="button" class="poner" data-poner={o.v} aria-pressed="false">
                          <span lang="ja" aria-hidden="true">{o.k}</span>
                          {o.t}
                        </button>
                        <span data-sellos data-valor={o.v} />
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </article>
        ))
      }
      </div>
    </div>
  </section>

  <section class="sec">
    <header>
      <span class="mono">Ojo</span>
      <h2>Fechas para esquivar</h2>
    </header>
    <table>
      <tbody>
        {
          evitar.map((e) => (
            <tr>
              <th scope="row">{e.q}</th>
              <td class="mono">{e.d}</td>
              <td>{e.p}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="sec">
    <header>
      <span class="mono">Nota</span>
      <h2>Sobre estos datos</h2>
    </header>
    <div>
      <p>
        Las temperaturas son promedios históricos aproximados de Tokio; gente y precio son una
        escala orientativa. Cerezos, lluvias y tifones salen de los promedios 1991–2020 del
        servicio meteorológico de Japón: en Tokio los cerezos abren hacia el 24 de marzo y están
        en plena flor hacia el 31; en Kioto, el 26 de marzo y el 4 de abril.
      </p>
      <p>
        El pronóstico de cerezos para 2027 todavía no ha salido: el de 2026 lo publicó la Japan
        Meteorological Corporation en diciembre de 2025. Los festivales caen en las mismas fechas
        cada año, pero las de 2027 y la temporada para subir el Fuji (en 2026 fue de julio al 10
        de septiembre) están <b>por confirmar</b> hasta que las anuncien.
      </p>
      <p class="mono">
        Fuentes:
        <a href="https://www.data.jma.go.jp/tokyo/shosai/kanyoho/sakura/sakura.html">Cerezos en Tokio (JMA)</a> ·
        <a href="https://www.data.jma.go.jp/kyoto/2_data/seibutsu/index.html">Cerezos y hojas rojas en Kioto (JMA)</a> ·
        <a href="https://www.data.jma.go.jp/cpd/baiu/index.html">Lluvias (JMA)</a> ·
        <a href="https://www.data.jma.go.jp/typhoon/statistics/average/average.html">Tifones (JMA)</a> ·
        <a href="https://www8.cao.go.jp/chosei/shukujitsu/gaiyou.html">Festivos de Japón (Oficina del Gabinete)</a> ·
        <a href="https://www.kankou-gifu.jp/event/detail_8488.html">Festival de Takayama (Gifu)</a> ·
        <a href="https://www.pref.ibaraki.jp/soshiki/eigyo/promo/20260522.html">Hitachi (Ibaraki)</a> ·
        <a href="https://www.sumidagawa-hanabi.com/">Fuegos del Sumida</a> ·
        <a href="https://www.fujisan-climb.jp/">Subir el Fuji</a> ·
        <a href="https://livejapan.com/en/article-a0001033/amp/">Live Japan</a> ·
        <a href="https://www.japanhighlights.com/japan/plan-a-cherry-blossom-trip">Japan Highlights</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .anio {
    border-bottom: 1px solid var(--ink);
    padding-block: 2rem;
  }
  .anio-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  .anio-head h2 {
    color: var(--shu-tinta);
    font-weight: 500;
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    max-width: none;
    color: var(--ink-soft);
  }
  .leyenda .bar {
    display: inline-block;
    width: 0.5rem;
    height: 0.9rem;
    background: var(--ink);
    vertical-align: -0.15em;
    margin-right: 0.3rem;
  }
  .scroll {
    overflow-x: auto;
    padding-inline: var(--gutter);
  }
  .meses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(5.2rem, 1fr));
    min-width: 63rem;
    border-left: 1px solid var(--hair);
  }
  .meses li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.45rem;
    padding: 0.75rem 0.4rem 1rem;
    border-right: 1px solid var(--hair);
    text-align: center;
  }
  .tag {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--shu);
    height: 3.2rem;
    writing-mode: vertical-rl;
  }
  .termo {
    position: relative;
    width: 100%;
    height: 11rem;
    background: repeating-linear-gradient(
      to top,
      transparent 0 calc(100% / 6.8 - 1px),
      var(--hair) calc(100% / 6.8 - 1px) calc(100% / 6.8)
    );
  }
  .rango {
    position: absolute;
    left: 50%;
    width: 0.7rem;
    margin-left: -0.35rem;
    background: var(--ink);
    border-radius: 99px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }
  .rango b {
    font-weight: 500;
    font-size: 0.68rem;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .rango b:first-child {
    transform: translateY(-1.3rem);
  }
  .rango b:last-child {
    transform: translateY(1.3rem);
  }
  .meses strong {
    font-family: var(--f-display);
    font-size: 1.25rem;
    margin-top: 1rem;
  }
  .dots {
    display: flex;
    gap: 3px;
  }
  .dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }
  .dot.on {
    background: var(--ink);
  }
  .yen {
    min-height: 1.1rem;
    letter-spacing: 0.05em;
  }
  .nota {
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--ink-soft);
    min-height: 3.9em; /* tres renglones: así los botones quedan a la misma altura */
  }
  .puedo {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    min-height: 4rem;
    align-content: start;
  }
  /* la columna es angosta: marcado se nota por el relleno, sin el ✓ que lo ensancha */
  .puedo .poner[aria-pressed='true']::before {
    content: none;
  }
  .puedo [data-sellos] {
    justify-content: center;
  }
  .temporada {
    font-size: 0.88rem !important;
    color: var(--ink-soft);
  }
  .temporada .mono {
    display: block;
    color: var(--shu-tinta);
    margin-bottom: 0.2rem;
  }
  .pie {
    margin: 1.5rem 0 0;
    max-width: none;
    color: var(--ink-soft);
  }

  /* ───── ventanas: papelitos de la fortuna (omikuji) ─────
     Angostos y altos: una columna por cada ~19rem, hasta tres. Cada papel parte su contenido
     en seis filas compartidas con los de su misma fila (subgrid): la frase, el 吉/凶, las
     fechas y el voto arrancan a la misma altura en todos. Si sobra espacio en la última fila,
     se raya, como en Lugares. */
  .candidatas {
    container-type: inline-size;
  }
  .ventanas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .ventanas::after {
    grid-row: span 6;
    background: repeating-linear-gradient(-45deg, transparent 0 7px, var(--hair) 7px 8px);
  }
  @container (38rem <= width < 57rem) {
    .ventanas {
      grid-template-columns: repeat(2, 1fr);
    }
    .ventanas:has(> article:last-child:nth-child(2n + 1))::after {
      content: '';
    }
  }
  @container (width >= 57rem) {
    .ventanas {
      grid-template-columns: repeat(3, 1fr);
    }
    .ventanas:has(> article:last-child:nth-child(3n + 1))::after {
      content: '';
      grid-column: span 2;
      grid-row: span 6;
    }
    .ventanas:has(> article:last-child:nth-child(3n + 2))::after {
      content: '';
    }
  }
  .ventanas article,
  .papel {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
  }
  .papel {
    grid-row: 1 / -1;
    padding: 1.35rem 1.5rem 0;
    border: 1px solid var(--ink);
    outline: 1px solid var(--hair);
    outline-offset: -5px;
    background: var(--paper);
    box-shadow:
      0 1px 0 var(--hair),
      0 8px 18px -12px rgba(25, 23, 20, 0.35);
  }
  .papel p {
    margin: 0;
    max-width: none;
  }
  /* encabezado: la tira del papel y el título con su suerte */
  .tira {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink-soft);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.35em;
  }
  .tira .mono {
    letter-spacing: 0.12em;
    font-size: 0.64rem;
  }
  .cab {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: start;
    margin-top: 1.4rem;
  }
  .cab h3 {
    font-size: 1.6rem;
  }
  .fechas {
    display: block;
    margin-top: 0.45rem;
    color: var(--ink-soft);
  }
  .cab .chip {
    margin-top: 0.8rem;
  }
  /* el sello de la época: lo único bermellón del papel, como el sello 旅 de la cabecera */
  .estacion {
    padding: 0.55rem 0.45rem;
    border-radius: 2px;
    background: var(--shu);
    color: var(--paper);
    writing-mode: vertical-rl;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: 0.08em;
  }
  /* la frase del oráculo */
  .oraculo {
    margin-block: 1.6rem !important;
    text-align: center;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 1.15rem;
    line-height: 1.5;
    text-wrap: balance;
  }
  .oraculo::before,
  .oraculo::after {
    color: var(--ink-soft);
  }
  .oraculo::before {
    content: '「';
  }
  .oraculo::after {
    content: '」';
  }
  /* a favor (吉) y en contra (凶) */
  .lineas {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hair);
  }
  .lineas p {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.6rem;
    font-size: 0.94rem;
    line-height: 1.62;
  }
  .lineas p > span:first-child {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .lineas .malo > span:first-child {
    color: var(--ink-soft);
  }
  .temporada {
    align-self: start;
    margin-block: 1.5rem 1.6rem !important;
  }

  /* ───── el voto: tres casillas de borde a borde del papel (好 · 可 · 否) ───── */
  .pie-voto {
    align-self: end;
    margin-inline: -1.5rem;
    border-top: 1px dashed var(--ink);
  }
  .pie-voto .titulo {
    padding: 1.1rem 1.5rem 0.5rem;
    color: var(--ink-soft);
  }
  .voto {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--hair);
  }
  .voto li {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    padding-bottom: 0.6rem;
  }
  .voto li + li {
    border-left: 1px solid var(--hair);
  }
  .voto .poner {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    width: 100%;
    padding: 0.55rem 0.2rem 0.5rem;
    border: 0;
    border-bottom: 1px solid var(--hair);
    border-radius: 0;
    background: none;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }
  .voto .poner span {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0;
    color: var(--ink-soft);
  }
  .voto .poner:hover {
    background: var(--paper-2);
  }
  .voto .poner[aria-pressed='true'] {
    background: var(--ink);

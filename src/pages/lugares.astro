---
import Base from '../layouts/Base.astro';
import { SEMILLAS, TEMAS, TEMPORADAS, ZONAS, etiquetaMeses, type Lugar } from '../data/lugares';
import creditos from '../data/fotos.json';
import articulos from '../data/articulos.json';
import { propuestos, type LugarPropuesto } from '../lib/lugares';
import { sesion } from '../lib/sesion';
import { resumenTarjeta } from '../data/escenas';
import Escenas from '../components/Escenas.astro';

// Se arma en el servidor en cada visita: con sesión se suman los lugares que propuso el grupo
// al final de su tema. Sin sesión solo se ve el catálogo inicial.
export const prerender = false;
Astro.response.headers.set('cache-control', 'private, no-store');

type Ficha = Lugar & Partial<Pick<LugarPropuesto, 'persona' | 'enlace' | 'imagen'>>;
const fotos = creditos as Record<string, { archivo: string; autor: string; licencia: string; fuente: string }>;

const yo = sesion(Astro.cookies);
let delGrupo: LugarPropuesto[] = [];
if (yo) {
  try {
    delGrupo = await propuestos();
  } catch {
    // sin base de datos igual se muestra el catálogo
  }
}

const todos: Ficha[] = [...SEMILLAS, ...delGrupo];

// Dentro de cada tema, siempre el orden del catálogo (y al final los propuestos): sellar no
// mueve nada, ni al momento ni al recargar. Lo que el grupo prefiere se ve en Decisiones.
const porTema = TEMAS.map((tema) => ({
  tema,
  lugares: todos.filter((l) => l.tema === tema.id),
}));

const zonaDe = Object.fromEntries(ZONAS.map((z) => [z.id, z.nombre]));
const foto = (l: Ficha) => l.imagen ?? (fotos[l.id] ? `/lugares/${fotos[l.id].archivo}` : undefined);
// El nombre lleva a leer sobre el lugar (Wikipedia, o el enlace de quien lo propuso);
// «Mapa» siempre lleva a Google Maps, también en los propuestos.
const leer = (l: Ficha) => l.enlace ?? (articulos as Record<string, string>)[l.id];
const mapa = (l: Ficha) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${l.nombre} ${l.jp ?? ''} Japan`)}`;
const conCredito = SEMILLAS.filter((l) => fotos[l.id]);

// Escenas de anime: el sello «聖地 N obras» en la foto y la línea «Sale en: …» en el texto.
// La ventana con las escenas la pinta src/scripts/escenas.ts al tocar «Ver escenas».
const conAnime = todos.filter((l) => resumenTarjeta(l.id)).length;
// los filtros de varias opciones: los menús con casillas (escritorio) y las fichas de la hoja (celular)
const GRUPOS = [
  { id: 'zona', nombre: 'Zona', todos: 'Todas las zonas', opciones: ZONAS },
  { id: 'temp', nombre: 'Temporada', todos: 'Todo el año', opciones: TEMPORADAS },
];
---

<Base title="Lugares" description="Lugares y eventos de Japón para votar entre todos.">
  <header class="page-head">
    <span class="kanji" aria-hidden="true">所</span>
    <div>
      <span class="mono">03 · tokoro · los lugares</span>
      <h1>Lugares</h1>
      <p>
        {todos.length} sitios y eventos para ir armando la ruta. Ponle tu sello a los que quieres
        conocer: la foto se pone a color cuando es tuyo. Si falta alguno, proponlo.
      </p>
    </div>
  </header>

  <div class="barra">
    <nav class="temas" aria-label="Temas">
      {
        porTema.map(({ tema, lugares }) => (
          <Fragment>
            <a href={`#${tema.id}`} data-ir-tema={tema.id}>
              <b aria-hidden="true">{tema.kanji}</b>
              <span>{tema.corto}</span>
              <small class="mono">{lugares.length}</small>
            </a>
          </Fragment>
        ))
      }
    </nav>
    {/* desde 960 px: los filtros en una fila, aplican al instante */}
    <div class="filtros">
      {
        GRUPOS.map((g) => (
          <div class="desp">
            <button type="button" class="menu" id={`f-${g.id}`} popovertarget={`p-${g.id}`} aria-expanded="false" aria-haspopup="true">
              <span data-texto>{g.todos}</span>
              <span class="flecha" aria-hidden="true" />
            </button>
            <div class="panel" id={`p-${g.id}`} popover>
              <fieldset>
                <legend class="oculto">{g.nombre}: se pueden escoger varias</legend>
                {g.opciones.map((o) => (
                  <label class="casilla">
                    <input type="checkbox" name={g.id} value={o.id} />
                    <span class="caja" aria-hidden="true" />
                    <span class="nom">{o.nombre}</span>
                    <small class="mono" data-n />
                  </label>
                ))}
              </fieldset>
              <button type="button" class="quitar-grupo" data-vaciar={g.id} hidden>Quitar</button>
            </div>
          </div>
        ))
      }
      <button type="button" class="ficha solo-mios con-tapa" id="f-mios" aria-pressed="false" data-si-no="mios">
        <span class="tapa tapa-sello" data-mi-sello aria-hidden="true"></span><span class="ficha-cuerpo"><span class="capa off">Mis sellos<small class="mono" data-n></small></span><span class="capa on" aria-hidden="true">✓ Mis sellos<small class="mono" data-n></small></span></span>
      </button>
      {
        conAnime > 0 && (
          <button type="button" class="ficha con-tapa" id="f-anime" aria-pressed="false" data-si-no="anime">
            <span class="tapa" aria-hidden="true">聖地</span><span class="ficha-cuerpo"><span class="capa off">Solo anime<small class="mono" data-n>{conAnime}</small></span><span class="capa on" aria-hidden="true">✓ Solo anime<small class="mono" data-n>{conAnime}</small></span></span>
          </button>
        )
      }
      <span class="mono total"><b id="f-total">{todos.length}</b> a la vista</span>
      <button type="button" class="proponer" data-proponer="">＋ Proponer<span class="largo"> lugar</span></button>
    </div>
    {/* por debajo de 960 px: un botón abre la hoja; al lado, lo que está puesto */}
    <div class="filtros-cel">
      <button type="button" class="abrir-filtros" id="abrir-filtros" aria-haspopup="dialog">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4h12M4.5 8h7M7 12h2" /></svg>
        Filtros<span class="cuantos" id="n-filtros" />
      </button>
      <div class="puestos" id="puestos" aria-label="Filtros puestos"><span class="sin mono">Sin filtros</span></div>
      <button type="button" class="proponer" data-proponer="">＋ Proponer</button>
    </div>
  </div>

  <p class="vacio wrap" id="vacio" hidden>
    <span id="vacio-dice">No hay nada con ese filtro.</span> <button type="button" id="limpiar">Quitar filtros</button>
  </p>

  {
    porTema.map(({ tema, lugares }) => (
      <section class="tema" id={tema.id}>
        <header>
          <span class="k" aria-hidden="true">{tema.kanji}</span>
          <div>
            <h2>{tema.nombre}</h2>
            <p>{tema.desc}</p>
          </div>
          <span class="mono cuenta"><b data-visibles>{lugares.length}</b> lugares</span>
        </header>
        <div class="rejilla">
          {
            lugares.map((l) => {
              const anime = resumenTarjeta(l.id);
              return (
              <article
                class="lugar"
                id={l.id}
                data-zona={l.zona}
                data-meses={l.meses?.join(',')}
                data-escenas={anime?.obras}
                data-marca={`lugar:${l.id}`}
              >
                <div class="foto">
                  {foto(l) ? (
                    <img src={foto(l)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="sin-foto" aria-hidden="true">{tema.kanji}</span>
                  )}
                  {l.meses && <span class="cuando mono">{etiquetaMeses(l.meses)}</span>}
                  {anime && (
                    <span class="sello-anime">
                      <b aria-hidden="true">聖地</b>
                      {anime.obras} {anime.obras === 1 ? 'obra' : 'obras'}
                    </span>
                  )}
                </div>
                <div class="cuerpo">
                  <p class="meta mono">
                    <span>{zonaDe[l.zona]}</span>
                    <a href={mapa(l)} target="_blank" rel="noopener noreferrer">Mapa ↗</a>
                  </p>
                  <h3>
                    {leer(l) ? (
                      <a class="leer" href={leer(l)} target="_blank" rel="noopener noreferrer"><span>{l.nombre}</span></a>
                    ) : (
                      l.nombre
                    )}
                  </h3>
                  {l.jp && <p class="jp" lang="ja">{l.jp}</p>}
                  {l.desc && <p class="desc">{l.desc}</p>}
                  {l.persona && (
                    <p class="propuso mono">
                      <span>Lo propuso</span>
                      <span data-sello-de={l.persona} />
                      {l.persona === yo && (
                        <button type="button" data-quitar={l.id}>Quitar</button>
                      )}
                    </p>
                  )}
                  {anime && (
                    <p class="linea-anime">
                      <span class="marca" aria-hidden="true">聖</span>
                      <span class="suave">Sale en:</span>{' '}
                      {/* «A», «A y B» o «A, B y N más» */}
                      {anime.nombres.map((x, i) => (
                        <Fragment>
                          {i > 0 && (anime.obras === 2 ? ' y ' : ', ')}
                          <em>{x}</em>
                        </Fragment>
                      ))}
                      {anime.obras > 2 && ` y ${anime.obras - 2} más`}.{' '}
                      <button type="button" class="ver-escenas" data-abrir-escenas={l.id}>Ver escenas →</button>
                      {anime.aparte && <span class="aparte">{anime.aparte}</span>}
                    </p>
                  )}
                </div>
                <div class="pie">
                  <button type="button" class="poner" data-poner="1" aria-pressed="false">Quiero ir</button>
                  <span class="juntos" data-sellos />
                </div>
              </article>
              );
            })
          }
          <button type="button" class="nueva" data-proponer={tema.id}>
            <span aria-hidden="true">＋</span>
            Proponer otro en {tema.corto.toLowerCase()}
          </button>
        </div>
      </section>
    ))
  }

  <section class="sec creditos">
    <header>
      <span class="mono">Fotos</span>
      <h2>Créditos</h2>
    </header>
    <details>
      <summary>Las fotos del catálogo son de Wikimedia Commons y Flickr, con licencias libres y atribución; las que no tienen foto libre usan la oficial del lugar. Ver autores</summary>
      <ul>
        {
          conCredito.map((l) => (
            <li>
              <a href={fotos[l.id].fuente} target="_blank" rel="noopener noreferrer">{l.nombre}</a>
              <span> — {fotos[l.id].autor.slice(0, 80)} · {fotos[l.id].licencia}</span>
            </li>
          ))
        }
      </ul>
    </details>
  </section>

  <button type="button" class="flotante" data-proponer="" aria-label="Proponer lugar" title="Proponer lugar">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
      <path d="M10 2v16M2 10h16" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
    </svg>
  </button>
  <button type="button" class="novedad mono" id="novedad" hidden>Hay lugares nuevos · Actualizar ↻</button>

  <Escenas />

  <dialog class="hoja-filtros" id="hoja-filtros" aria-labelledby="hf-titulo">
    <div class="hf">
      <header>
        <h2 id="hf-titulo" tabindex="-1">Filtros</h2>
        <button type="button" class="hf-cerrar" data-cerrar-hoja>Cerrar ✕</button>
      </header>
      {
        GRUPOS.map((g) => (
          <div class="hf-grupo" role="group" aria-labelledby={`hf-${g.id}`}>
            <span class="mono" id={`hf-${g.id}`}>{g.nombre} · una o varias</span>
            <div class="hf-opciones">
              {g.opciones.map((o) => (
                <button type="button" class="ficha" aria-pressed="false" data-grupo={g.id} data-v={o.id} data-nombre={o.nombre}>
                  <span class="ficha-cuerpo"><span class="capa off">{o.nombre}<small class="mono" data-n /></span><span class="capa on" aria-hidden="true">✓ {o.nombre}<small class="mono" data-n /></span></span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
      <div class="hf-grupo" role="group" aria-labelledby="hf-solo">
        <span class="mono" id="hf-solo">Mostrar solo</span>
        <div class="hf-opciones">
          <button type="button" class="ficha solo-mios con-tapa" aria-pressed="false" data-si-no="mios">
            <span class="tapa tapa-sello" data-mi-sello aria-hidden="true"></span><span class="ficha-cuerpo"><span class="capa off">Mis sellos<small class="mono" data-n></small></span><span class="capa on" aria-hidden="true">✓ Mis sellos<small class="mono" data-n></small></span></span>
          </button>
          {
            conAnime > 0 && (
              <button type="button" class="ficha con-tapa" aria-pressed="false" data-si-no="anime">
                <span class="tapa" aria-hidden="true">聖地</span><span class="ficha-cuerpo"><span class="capa off">Solo anime<small class="mono" data-n></small></span><span class="capa on" aria-hidden="true">✓ Solo anime<small class="mono" data-n></small></span></span>
              </button>
            )
          }
        </div>
      </div>
      <div class="hf-pie">
        <button type="button" class="hf-limpiar" data-limpiar-hoja>Quitar todo</button>
        <button type="button" class="hf-ver" data-aplicar>Ver lugares</button>
      </div>
    </div>
  </dialog>

  <dialog id="proponer" class="registro" aria-labelledby="proponer-t">
    <form method="dialog">
      <button type="button" class="cerrar mono" data-cerrar aria-label="Cerrar">Cerrar ✕</button>
      <span class="mono">Nuevo lugar · 新しい場所</span>
      <h2 id="proponer-t">Proponer</h2>
      <label>
        <span class="mono">Nombre del lugar o evento</span>
        <input name="nombre" autofocus required minlength="2" maxlength="60" autocomplete="off" />
      </label>
      <div class="dos">
        <label>
          <span class="mono">Tema</span>
          <select name="tema" required>
            {TEMAS.map((t) => <option value={t.id}>{t.nombre}</option>)}
          </select>
        </label>
        <label>
          <span class="mono">Zona</span>
          <select name="zona" required>
            {ZONAS.map((z) => <option value={z.id}>{z.nombre}</option>)}
          </select>
        </label>
      </div>
      <label>
        <span class="mono">¿Por qué vale la pena?</span>
        <textarea name="nota" rows="2" maxlength="240"></textarea>
      </label>
      <label>
        <span class="mono">¿Cuándo se puede?</span>
        <select name="temporada">
          <option value="">Todo el año</option>
          {TEMPORADAS.map((t) => <option value={t.id}>Solo en {t.nombre.toLowerCase()}</option>)}
        </select>
      </label>
      <label>
        <span class="mono">Enlace (opcional)</span>
        <input name="enlace" type="url" inputmode="url" placeholder="https://" maxlength="500" />
      </label>
      <label>
        <span class="mono">Enlace de una foto (opcional)</span>
        <input name="imagen" type="url" inputmode="url" placeholder="https://" maxlength="500" />
      </label>
      <p role="alert" class="error"></p>
      <button type="submit" class="sellar">Proponer <span aria-hidden="true">→</span></button>
    </form>
  </dialog>
</Base>

<script>
  import { copiar, cuantosPuestos, escribirDireccion, leerDireccion, pasa, queDejaVacio, sinFiltros, textoMenu, type Filtros, type LugarFiltrable } from '../scripts/filtros';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  // ───── filtros ─────
  // Desde 960 px: menús con casillas y fichas que aplican al instante. Por debajo: la hoja, que
  // trabaja sobre un borrador y aplica con «Ver N lugares». La lógica sin DOM está en scripts/filtros.ts.
  const total = $('f-total')!;
  const vacio = $('vacio')!;
  const hoja = $<HTMLDialogElement>('hoja-filtros')!;
  const dlg = $<HTMLDialogElement>('proponer')!;
  const form = dlg.querySelector('form')!;
  const aviso = dlg.querySelector<HTMLElement>('[role=alert]')!;
  const conSesion = () => document.documentElement.dataset.sesion === 'si';
  const GRUPOS = ['zona', 'temp'] as const;
  type Grupo = (typeof GRUPOS)[number];
  const angosto = matchMedia('(max-width: 959px)');

  let aplicado: Filtros = sinFiltros();
  let borrador: Filtros | null = null;

  const tarjetas = () => [...document.querySelectorAll<HTMLElement>('.tema .lugar')];

  // ───── la foto a la vista ─────
  // El hover del escritorio, en el celular: la foto que cruza la franja del medio de la pantalla
  // (el 20 % central) pasa a color, y vuelve a gris cuando sale. El CSS solo lo aplica sin cursor.
  const franja = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) e.target.closest('.lugar')?.classList.toggle('a-la-vista', e.isIntersecting);
    },
    { rootMargin: '-40% 0px -40% 0px' },
  );
  for (const f of document.querySelectorAll('.tema .lugar .foto')) franja.observe(f);
  const datosDe = (c: HTMLElement): LugarFiltrable => ({
    zona: c.dataset.zona ?? '',
    meses: c.dataset.meses ? c.dataset.meses.split(',').map(Number) : null,
    mio: !!c.querySelector('.poner[aria-pressed="true"]'),
    escenas: !!c.dataset.escenas,
  });
  /** Cuántos lugares pasan con estos filtros. */
  const cuenta = (lugares: LugarFiltrable[], f: Filtros) => lugares.filter((l) => pasa(l, f)).length;

  /**
   * Los números de cada opción para unos filtros: en una zona o temporada, cuántos lugares tiene
   * esa opción con los demás filtros puestos; en Mis sellos y Solo anime, cuántos quedarían al prenderlo.
   */
  function numeros(lugares: LugarFiltrable[], f: Filtros) {
    const n: Record<string, number> = {};
    for (const g of GRUPOS)
      for (const el of document.querySelectorAll<HTMLInputElement>(`.panel input[name="${g}"]`))
        n[`${g}:${el.value}`] = cuenta(lugares, { ...copiar(f), [g]: [el.value] });
    n.mios = cuenta(lugares, { ...copiar(f), mios: true });
    n.anime = cuenta(lugares, { ...copiar(f), anime: true });
    return n;
  }

  /** Pinta un juego de controles (la barra o la hoja) con unos filtros y sus números. */
  function pintarControles(raiz: ParentNode, f: Filtros, n: Record<string, number>) {
    for (const g of GRUPOS) {
      // casillas del menú (escritorio)
      for (const el of raiz.querySelectorAll<HTMLInputElement>(`.panel input[name="${g}"]`)) {
        const on = f[g].includes(el.value);
        const k = n[`${g}:${el.value}`];
        el.checked = on;
        el.disabled = !on && k === 0;
        el.closest('label')!.querySelector('[data-n]')!.textContent = String(k);
      }
      // fichas de la hoja (celular)
      for (const el of raiz.querySelectorAll<HTMLElement>(`[data-grupo="${g}"]`)) {
        const on = f[g].includes(el.dataset.v!);
        const k = n[`${g}:${el.dataset.v}`];
        el.setAttribute('aria-pressed', String(on));
        el.classList.toggle('apagado', !on && k === 0);
        for (const x of el.querySelectorAll('[data-n]')) x.textContent = String(k);
      }
      const menu = raiz.querySelector<HTMLElement>(`#f-${g}`);
      if (menu) {
        menu.querySelector('[data-texto]')!.textContent = textoMenu(g, f[g]);
        menu.classList.toggle('escogido', f[g].length > 0);
        $(`p-${g}`)!.querySelector<HTMLElement>('[data-vaciar]')!.hidden = f[g].length === 0;
      }
    }
    for (const el of raiz.querySelectorAll<HTMLElement>('[data-si-no]')) {
      const que = el.dataset.siNo as 'mios' | 'anime';
      el.setAttribute('aria-pressed', String(f[que]));
      for (const x of el.querySelectorAll('[data-n]')) x.textContent = String(n[que]);
      // «Mis sellos» siempre se puede tocar (sin sellos, la lista vacía lo explica); anime se apaga en 0
      if (que === 'anime') el.classList.toggle('apagado', !f.anime && n.anime === 0);
    }
  }

  /** Lo que está puesto, como fichas con ✕ al lado del botón «Filtros» (celular). */
  function pintarPuestos(f: Filtros) {
    const puestos = $('puestos')!;
    const nombre = (g: Grupo, v: string) => document.querySelector<HTMLElement>(`[data-grupo="${g}"][data-v="${v}"]`)!.dataset.nombre!;
    const fichas = [
      ...GRUPOS.flatMap((g) => f[g].map((v) => ({ g, v, t: nombre(g, v) }))),
      ...(f.mios ? [{ g: 'mios', v: '', t: 'Mis sellos' }] : []),
      ...(f.anime ? [{ g: 'anime', v: '', t: '聖地 Solo anime' }] : []),
    ];
    puestos.replaceChildren(
      ...(fichas.length
        ? fichas.map(({ g, v, t }) => {
            const s = document.createElement('span');
            s.className = 'puesto';
            const b = document.createElement('button');
            b.type = 'button';
            b.dataset.quitarFiltro = g;
            b.dataset.v = v;
            b.setAttribute('aria-label', `Quitar ${t}`);
            b.textContent = '✕';
            s.append(t, b);
            return s;
          })
        : [Object.assign(document.createElement('span'), { className: 'sin mono', textContent: 'Sin filtros' })]),
    );
    // los estilos de la página son de alcance local: lo nuevo hereda la marca del contenedor
    const marca = [...puestos.attributes].filter((a) => a.name.startsWith('data-astro-cid-'));
    for (const el of puestos.querySelectorAll('*')) for (const a of marca) el.setAttribute(a.name, '');
    const n = cuantosPuestos(f);
    $('n-filtros')!.textContent = n ? String(n) : '';
    marcarDesborde();
  }

  /** Si lo puesto no cabe, el borde derecho se desvanece: así se nota que hay más deslizando. */
  function marcarDesborde() {
    const p = $('puestos')!;
    p.classList.toggle('hay-mas', p.scrollLeft + p.clientWidth < p.scrollWidth - 2);
  }
  $('puestos')!.addEventListener('scroll', marcarDesborde, { passive: true });
  addEventListener('resize', marcarDesborde);

  /**
   * Al poner o quitar mi sello en una tarjeta («Quiero ir») cambian los números de los filtros
   * (cuántos «Mis sellos» hay): se actualizan de una. Las tarjetas no se esconden ni se mueven
   * hasta el próximo cambio de filtro: poner un sello nunca mueve la página.
   */
  let numerosPendientes = false;
  function actualizarNumeros() {
    if (numerosPendientes) return;
    numerosPendientes = true;
    requestAnimationFrame(() => {
      numerosPendientes = false;
      const datos = tarjetas().map(datosDe);
      pintarControles(document.querySelector('.filtros')!, aplicado, numeros(datos, aplicado));
      if (borrador) pintarHoja();
    });
  }
  const ojoSellos = new MutationObserver(actualizarNumeros);
  for (const b of document.querySelectorAll('.tema .lugar [data-poner]'))
    ojoSellos.observe(b, { attributes: true, attributeFilter: ['aria-pressed'] });

  /** Muestra u oculta tarjetas según lo aplicado y actualiza números, controles y dirección. */
  function filtrar() {
    const cs = tarjetas();
    const datos = cs.map(datosDe);
    let suma = 0;
    for (const tema of document.querySelectorAll<HTMLElement>('.tema')) {
      let n = 0;
      for (const c of tema.querySelectorAll<HTMLElement>('.lugar')) {
        const ver = pasa(datos[cs.indexOf(c)], aplicado);
        c.hidden = !ver;
        if (ver) n++;
      }
      tema.hidden = n === 0;
      tema.querySelector('[data-visibles]')!.textContent = String(n);
      const enBarra = document.querySelector<HTMLElement>(`[data-ir-tema="${tema.id}"]`);
      if (enBarra) {
        enBarra.querySelector('small')!.textContent = String(n);
        enBarra.classList.toggle('apagado', n === 0);
      }
      suma += n;
    }
    total.textContent = String(suma);
    vacio.hidden = suma > 0;
    if (suma === 0) $('vacio-dice')!.textContent = queDejaVacio(aplicado);
    pintarControles(document.querySelector('.filtros')!, aplicado, numeros(datos, aplicado));
    pintarPuestos(aplicado);
    if (borrador) pintarHoja();
    // los filtros quedan en la dirección: se pueden compartir y sobreviven a una recarga
    history.replaceState(history.state, '', `${location.pathname}${escribirDireccion(aplicado)}${location.hash}`);
  }

  /**
   * Cuando la persona cambia un filtro estando más abajo del comienzo de la lista, la página
   * sube al comienzo: la lista se encoge y si no, queda frente a los créditos o una sola tarjeta.
   * Arriba de la lista no se mueve nada.
   */
  function aplicar(f: Filtros) {
    aplicado = f;
    filtrar();
    const barra = document.querySelector<HTMLElement>('.barra')!;
    const primero = [vacio, ...document.querySelectorAll<HTMLElement>('.tema')].find((e) => !e.hidden);
    if (!primero) return;
    const comienzo = primero.getBoundingClientRect().top + scrollY - barra.offsetHeight;
    // de una, sin animación: deslizar miles de píxeles marea y deja ver pasar media página
    if (scrollY > comienzo + 1) scrollTo({ top: comienzo, behavior: 'instant' });
  }
  /** Prende o apaga un valor de una lista, dejando el orden del catálogo. */
  function alternar(f: Filtros, g: Grupo, v: string): Filtros {
    const nuevo = copiar(f);
    const orden = [...document.querySelectorAll<HTMLInputElement>(`.panel input[name="${g}"]`)].map((i) => i.value);
    const set = new Set(nuevo[g]);
    if (set.has(v)) set.delete(v);
    else set.add(v);
    nuevo[g] = orden.filter((x) => set.has(x));
    return nuevo;
  }
  /** «Mis sellos» sin sesión abre el registro en vez de filtrar. */
  const pideSesion = (que: string) => que === 'mios' && !conSesion() && (document.querySelector<HTMLElement>('#quien [data-entrar]')?.click(), true);

  // escritorio: casillas y fichas aplican al instante
  document.querySelector('.filtros')!.addEventListener('change', (ev) => {
    const el = ev.target as HTMLInputElement;
    if (el.type === 'checkbox') aplicar(alternar(aplicado, el.name as Grupo, el.value));
  });
  document.querySelector('.filtros')!.addEventListener('click', (ev) => {
    const el = ev.target as Element;
    const ficha = el.closest<HTMLElement>('[data-si-no]');
    if (ficha) {
      const que = ficha.dataset.siNo as 'mios' | 'anime';
      if (pideSesion(que)) return;
      aplicar({ ...copiar(aplicado), [que]: !aplicado[que] });
      return;
    }
    const vaciar = el.closest<HTMLElement>('[data-vaciar]');
    if (vaciar) {
      const g = vaciar.dataset.vaciar as Grupo;
      aplicar({ ...copiar(aplicado), [g]: [] });
      $(`p-${g}`)!.hidePopover();
    }
  });
  /**
   * Cada menú reserva el ancho del texto más largo que puede mostrar («Hiroshima y Shikoku», «Zona · 7»…):
   * así escoger una opción nunca lo agranda ni corre la fila. Se mide con las fuentes ya cargadas.
   */
  function reservarAnchoMenus() {
    for (const g of GRUPOS) {
      const boton = $(`f-${g}`)!;
      const texto = boton.querySelector<HTMLElement>('[data-texto]')!;
      const valores = [...document.querySelectorAll<HTMLInputElement>(`.panel input[name="${g}"]`)].map((i) => i.value);
      const posibles = [textoMenu(g, []), textoMenu(g, valores), ...valores.map((v) => textoMenu(g, [v]))];
      const actual = texto.textContent;
      boton.style.minWidth = '';
      let mayor = 0;
      for (const t of posibles) {
        texto.textContent = t;
        mayor = Math.max(mayor, boton.getBoundingClientRect().width);
      }
      texto.textContent = actual;
      boton.style.minWidth = `${Math.ceil(mayor)}px`;
    }
  }
  document.fonts.ready.then(reservarAnchoMenus);

  // los menús: el panel se abre debajo de su botón y lo sigue si la página se mueve
  for (const g of GRUPOS) {
    const panel = $(`p-${g}`)!;
    const boton = $(`f-${g}`)!;
    const ubicar = () => {
      const r = boton.getBoundingClientRect();
      panel.style.top = `${r.bottom + 6}px`;
      // nunca más alto que lo que queda de pantalla: si no cabe, se desliza por dentro
      panel.style.maxHeight = `${Math.max(160, innerHeight - r.bottom - 22)}px`;
      panel.style.left = `${Math.min(r.left, innerWidth - panel.offsetWidth - 16)}px`;
    };
    panel.addEventListener('toggle', (ev) => {
      const abierto = (ev as ToggleEvent).newState === 'open';
      boton.setAttribute('aria-expanded', String(abierto));
      if (abierto) {
        ubicar();
        addEventListener('scroll', ubicar, { passive: true });
        panel.querySelector<HTMLInputElement>('input:not(:disabled)')?.focus();
      } else removeEventListener('scroll', ubicar);
    });
  }

  // celular: el botón «Filtros», las fichas de lo puesto y la hoja
  function pintarHoja() {
    if (!borrador) return;
    const datos = tarjetas().map(datosDe);
    pintarControles(hoja, borrador, numeros(datos, borrador));
    const n = cuenta(datos, borrador);
    const ver = hoja.querySelector<HTMLButtonElement>('[data-aplicar]')!;
    ver.disabled = n === 0;
    ver.textContent = n === 0 ? 'Ningún lugar' : `Ver ${n} ${n === 1 ? 'lugar' : 'lugares'}`;
  }
  // la hoja vive en el historial: «atrás» la cierra sin salir de la página
  let hojaEmpujada = false;
  /** Lo que se hace una vez cerrada la hoja (aplicar), ya con el historial en su sitio. */
  let alCerrar: (() => void) | null = null;
  const despuesDeCerrar = () => {
    const f = alCerrar;
    alCerrar = null;
    f?.();
  };
  function abrirHoja() {
    borrador = copiar(aplicado);
    pintarHoja();
    // la restauración del scroll se guarda en cada entrada del historial: la de esta página no debe
    // devolver a donde estaba al cerrar la hoja, o pisaría el salto al comienzo de la lista
    history.scrollRestoration = 'manual';
    history.pushState({ hoja: true }, '', location.href);
    hojaEmpujada = true;
    hoja.showModal();
    hoja.querySelector<HTMLElement>('#hf-titulo')!.focus();
  }
  hoja.addEventListener('close', () => {
    borrador = null;
    $('abrir-filtros')!.focus();
    if (hojaEmpujada) {
      // «atrás» es asíncrono: lo que haya que aplicar espera a que termine (ver popstate)
      hojaEmpujada = false;
      history.back();
    } else despuesDeCerrar();
  });
  addEventListener('popstate', () => {
    if (hoja.open) {
      // «atrás» del navegador con la hoja abierta: se cierra sin aplicar
      hojaEmpujada = false;
      alCerrar = null;
      hoja.close();
    } else {
      despuesDeCerrar();
      // la restauración del navegador llega tarde y sin aviso: vuelve a «auto» con lo próximo que haga la persona
      if (history.scrollRestoration === 'manual') {
        const devolver = () => {
          history.scrollRestoration = 'auto';
          for (const t of ['pointerdown', 'keydown', 'wheel', 'touchstart']) removeEventListener(t, devolver);
        };
        for (const t of ['pointerdown', 'keydown', 'wheel', 'touchstart']) addEventListener(t, devolver, { passive: true });
      }
    }
  });
  $('abrir-filtros')!.addEventListener('click', abrirHoja);
  hoja.addEventListener('click', (ev) => {
    const el = ev.target as Element;
    if (el === hoja || el.closest('[data-cerrar-hoja]')) return hoja.close();
    if (!borrador) return;
    const op = el.closest<HTMLElement>('[data-grupo]');
    const sn = el.closest<HTMLElement>('[data-si-no]');
    if (op) borrador = alternar(borrador, op.dataset.grupo as Grupo, op.dataset.v!);
    else if (sn) borrador = { ...copiar(borrador), [sn.dataset.siNo!]: !borrador[sn.dataset.siNo as 'mios' | 'anime'] };
    else if (el.closest('[data-limpiar-hoja]')) borrador = sinFiltros();
    else if (el.closest('[data-aplicar]')) {
      const f = borrador;
      alCerrar = () => aplicar(f);
      hoja.close();
      return;
    } else return;
    pintarHoja();
  });
  $('puestos')!.addEventListener('click', (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-quitar-filtro]');
    if (!b) return;
    const g = b.dataset.quitarFiltro!;
    aplicar(g === 'mios' || g === 'anime' ? { ...copiar(aplicado), [g]: false } : alternar(aplicado, g as Grupo, b.dataset.v!));
  });
  // al pasar a escritorio con la hoja abierta, se cierra sin aplicar
  angosto.addEventListener('change', () => !angosto.matches && hoja.open && hoja.close());

  $('limpiar')!.addEventListener('click', () => aplicar(sinFiltros()));

  // estado inicial desde la dirección (p. ej. /lugares?t=otono viene de «Cuándo ir»)
  {
    const pedido = leerDireccion(location.search);
    if (!$('f-anime')) pedido.anime = false;
    const quiereMios = pedido.mios;
    aplicado = { ...pedido, mios: false };
    filtrar();
    // «mis sellos» depende de que los sellos ya estén pintados
    if (quiereMios) {
      const prender = () => {
        if (!conSesion()) return false;
        aplicado = { ...copiar(aplicado), mios: true };
        filtrar();
        return true;
      };
      requestAnimationFrame(() => {
        if (prender()) return;
        // Dispositivo recién ingresado: todavía no hay estado guardado y la sesión se confirma
        // cuando responde el servidor. Se espera a ese momento (los sellos se pintan en la misma pasada).
        const ojo = new MutationObserver(() => prender() && ojo.disconnect());
        ojo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-sesion'] });
      });
    }
  }

  // Una foto que no carga (el enlace de un lugar propuesto se cayó) se cambia por el kanji
  // del tema, igual que las tarjetas sin foto.
  function sinFoto(img: HTMLImageElement) {
    const s = document.createElement('span');
    s.className = 'sin-foto';
    s.setAttribute('aria-hidden', 'true');
    s.textContent = img.closest('.tema')?.querySelector('.k')?.textContent ?? '';
    // los estilos de la página son de alcance local: el nuevo elemento hereda la marca de la foto
    for (const a of img.attributes) if (a.name.startsWith('data-astro-cid-')) s.setAttribute(a.name, '');
    img.replaceWith(s);
  }
  document.addEventListener(
    'error',
    (ev) => {
      const el = ev.target;
      if (el instanceof HTMLImageElement && el.closest('.foto')) sinFoto(el);
    },
    true,
  );
  // las que fallaron antes de que este código arrancara: se vuelven a pedir para que avisen
  for (const img of document.querySelectorAll<HTMLImageElement>('.foto img'))
    if (img.complete && img.naturalWidth === 0) img.src = img.src;

  async function enviar(ruta: string, datos: unknown) {
    const r = await fetch(`/api/${ruta}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(datos),
    });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error ?? 'Algo falló. Intenta de nuevo.');
    return j;
  }

  /** Recarga conservando filtros y saltando, si se pide, a una tarjeta. */
  function recargar(ancla = '') {
    history.replaceState(null, '', `${location.pathname}${location.search}${ancla ? `#${ancla}` : ''}`);
    // al recargar, el navegador vuelve a donde estaba el scroll y se salta el ancla:
    // se le pide que no lo haga y la página nueva se encarga de ir a la tarjeta
    if (ancla) history.scrollRestoration = 'manual';
    location.reload();
  }
  if (history.scrollRestoration === 'manual') {
    history.scrollRestoration = 'auto';
    document.getElementById(location.hash.slice(1))?.scrollIntoView();
  }

  document.addEventListener('click', (ev) => {
    const el = ev.target as Element;

    const p = el.closest<HTMLElement>('[data-proponer]');
    if (p) {
      if (!conSesion()) return document.querySelector<HTMLElement>('#quien [data-entrar]')?.click();
      if (p.dataset.proponer) (form.elements.namedItem('tema') as HTMLSelectElement).value = p.dataset.proponer;
      // con una sola zona escogida, el lugar nuevo empieza en esa zona
      if (aplicado.zona.length === 1) (form.elements.namedItem('zona') as HTMLSelectElement).value = aplicado.zona[0];
      aviso.textContent = '';
      dlg.showModal();
      return;
    }

    // quitar pide dos toques
    const b = el.closest<HTMLElement>('[data-quitar]');
    if (b) {
      if (!b.classList.contains('seguro')) {
        b.classList.add('seguro');
        b.textContent = '¿Seguro?';
        return;
      }
      enviar('quitar-lugar', { id: b.dataset.quitar })
        .then(() => recargar())
        .catch((e) => (b.textContent = (e as Error).message));
    }
  });

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const boton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    boton.disabled = true;
    try {
      const { id } = await enviar('lugares', Object.fromEntries(new FormData(form)));
      recargar(id);
    } catch (e) {
      aviso.textContent = (e as Error).message;
      boton.disabled = false;
    }
  });

  // alguien propuso un lugar mientras esta página estaba abierta: se ofrece recargar, sin forzarlo
  const novedad = $('novedad')!;
  document.addEventListener('grupo:lugares-nuevos', () => (novedad.hidden = false));
  novedad.addEventListener('click', () => recargar());

  // al entrar o salir cambia lo que el servidor muestra (los lugares del grupo)
  document.addEventListener('grupo:sesion', () => recargar());
</script>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* ───── barra fija: temas y filtros ───── */
  .barra {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }
  .temas {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--hair);
    padding-inline: calc(var(--gutter) - 0.9rem);
  }
  .temas a {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .temas b {
    font-family: var(--f-display);
    font-size: 1.15rem;
    color: var(--shu);
  }
  .temas span {
    font-size: 0.88rem;
    font-weight: 500;
  }
  .temas small {
    color: var(--ink-soft);
    font-size: 0.6rem;
  }
  .temas a.apagado {
    opacity: 0.3;
    pointer-events: none;
  }
  /* ───── filtros (desde 960 px): una fila que aplica al instante ───── */
  .filtros {
    display: flex;
    align-items: center;
    gap: 0.5rem 0.6rem;
    padding: 0.55rem var(--gutter);
  }
  /* todos los controles de la fila miden lo mismo, comparten eje y el mismo aire: --px a los lados,
     --sep entre lo de adentro. Se tocan en 44 px */
  .barra,
  .hoja-filtros {
    --px: 0.9rem;
    --sep: 0.45rem;
  }
  .menu,
  .ficha,
  .proponer,
  .abrir-filtros {
    position: relative;
    box-sizing: border-box;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--sep);
    height: 2rem;
    padding: 0 var(--px);
    border: 1px solid var(--ink);
    border-radius: 99px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }
  :is(.menu, .ficha, .abrir-filtros)::after {
    content: '';
    position: absolute;
    inset: -0.4rem 0;
  }
  :is(.menu, .ficha, .abrir-filtros):hover {
    background: var(--paper-2);
  }
  /* el menú: «Todas las zonas», «Tokio» o «Zona · 2». Ancho reservado: cambiar el texto no corre la fila */
  /* el ancho mínimo de cada menú lo pone el script: el de su texto más largo (ver reservarAnchoMenus) */
  .menu {
    justify-content: space-between;
  }
  .menu .flecha {
    width: 0.62rem;
    height: 0.38rem;
    background: currentColor;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transition: transform 0.15s;
  }
  .menu[aria-expanded='true'] .flecha {
    transform: rotate(180deg);
  }
  /* algo escogido: se rellena, igual que una ficha prendida */
  .menu.escogido,
  .ficha[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  /* el panel del menú: lista vertical con casillas y el número de cada opción */
  .panel {
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: 15rem;
    padding: 0.4rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .panel {
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .panel fieldset {
    display: grid;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .casilla {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .casilla:hover {
    background: var(--paper-2);
  }
  /* la casilla nativa sigue ahí (teclado, lector de pantalla); se ve la dibujada con la tinta del sitio */
  .casilla input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .caja {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    font-size: 0.75rem;
    line-height: 1;
  }
  .casilla input:checked + .caja {
    background: var(--ink);
    color: var(--paper);
  }
  .casilla input:checked + .caja::before {
    content: '✓';
  }
  .casilla input:checked ~ .nom {
    font-weight: 700;
  }
  .casilla input:focus-visible + .caja {
    outline: 2px solid var(--shu);
    outline-offset: 2px;
  }
  .casilla:has(input:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  .casilla small {
    font-size: 0.62rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .quitar-grupo {
    min-height: 2.75rem;
    margin: 0.2rem 0.6rem 0;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--hair);
    width: calc(100% - 1.2rem);
    text-align: left;
    background: none;
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--shu);
    text-underline-offset: 0.25em;
  }
  .quitar-grupo[hidden] {
    display: none;
  }
  /* fichas de sí o no (y las opciones de la hoja): dos capas en la misma celda, apagada y prendida
     con ✓. La ficha mide lo que la más ancha y cada capa va centrada: el aire queda igual a lado y
     lado, y prender no mueve nada. La capa apagada se esconde con opacidad (no con visibility) para
     que el lector de pantalla siga leyendo su texto; la prendida va con aria-hidden */
  .ficha {
    display: inline-grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    /* el aire lo ponen la tapa y el cuerpo; la separación de la base no aplica aquí */
    gap: 0;
    padding: 0;
  }
  .ficha.con-tapa {
    grid-template-columns: auto 1fr;
  }
  .ficha-cuerpo {
    display: grid;
    padding: 0 var(--px);
  }
  .capa {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sep);
  }
  .capa.on,
  .ficha[aria-pressed='true'] .capa.off {
    opacity: 0;
  }
  .ficha[aria-pressed='true'] .capa.on {
    opacity: 1;
  }
  /* el número cambia con los demás filtros: su espacio es fijo (dos cifras), así «26» → «0» no corre la fila */
  .ficha small {
    min-width: 2.6ch;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .ficha[aria-pressed='true'] small {
    color: var(--paper);
    opacity: 0.75;
  }
  .ficha.apagado {
    opacity: 0.35;
    pointer-events: none;
  }
  /* la tapa: el sello 聖地 de las tarjetas, a todo el alto. Apagada va dibujada; prendida, la ficha
     entera se llena de negro y queda igual al sello de la tarjeta */
  .tapa {
    display: grid;
    place-items: center;
    padding: 0 0.6rem 0 0.75rem;
    border-right: 1px dashed currentColor;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0;
  }
  .ficha[aria-pressed='true'] .tapa {
    border-right-color: rgba(241, 236, 225, 0.5);
  }
  /* «Mis sellos» lleva mi sello: la misma marca que pongo en las tarjetas, como el 聖地 de «Solo
     anime». Es el sello entero, reducido (cada forma acomoda su sílaba a su manera), sin las
     iniciales, que en pequeño no se leen. Prendida, va en color papel, igual que el 聖地 */
  .tapa-sello {
    position: relative;
    width: 1.1rem;
    box-sizing: content-box;
  }
  .tapa-sello :global(.sello-p) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(0.62);
  }
  /* sin iniciales la sílaba queda centrada en la silueta */
  .tapa-sello :global(.sello-p i) {
    display: none;
  }
  /* el círculo y el cuadrado van en la parte de arriba del sello: se bajan para quedar al centro */
  .tapa-sello :global(.sello-p:is(.f-maru, .f-masu)) {
    top: calc(50% + 0.26rem);
  }
  .ficha[aria-pressed='true'] .tapa-sello :global(.sello-p) {
    color: var(--paper);
  }
  .tapa-sello:empty {
    display: none;
  }
  @media (max-width: 1199px) {
    .proponer .largo {
      display: none;
    }
  }

  /* ───── por debajo de 960 px: botón «Filtros», lo puesto y la hoja ───── */
  .filtros-cel {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem var(--gutter);
  }
  .abrir-filtros svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .cuantos {
    display: inline-grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.25rem;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.56rem;
  }
  .cuantos:empty {
    display: none;
  }
  /* lo puesto: una fila de alto fijo que se desliza de lado si no cabe */
  .puestos {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .puestos.hay-mas {
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }
  .puestos .sin {
    color: var(--ink-soft);
    font-size: 0.62rem;
  }
  .puesto {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2rem;
    padding: 0 0.2rem 0 0.75rem;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--f-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .puesto button {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--paper);
    font-size: 0.8rem;
  }
  .puesto button::after {
    content: '';
    position: absolute;
    inset: -0.6rem -0.3rem;
  }
  @media (max-width: 1199px) {
    .filtros .total {
      display: none;
    }
  }
  @media (max-width: 959px) {
    .filtros {
      display: none;
    }
    .filtros-cel {
      display: flex;
    }
  }
  /* la hoja: sube desde abajo, como la de las escenas */
  .hoja-filtros {
    inset: auto 0 0 0;
    width: auto;
    max-width: 40rem;
    max-height: 92dvh;
    margin: 0 auto;
    padding: 0;
    border: 1px solid var(--ink);
    border-bottom: 0;
    border-radius: 1rem 1rem 0 0;
    background: var(--paper);
    color: var(--ink);
  }
  .hoja-filtros::backdrop {
    background: rgba(25, 23, 20, 0.55);
  }
  .hf {
    display: grid;
    gap: 1.1rem;
    padding: 1rem 16px calc(1.1rem + env(safe-area-inset-bottom));
  }
  .hf header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hf h2 {
    font-size: 1.4rem;
  }
  .hf h2:focus {
    outline: none;
  }
  .hf-cerrar,
  .hf-limpiar {
    min-height: 2.75rem;
    padding: 0 0.2rem;
    border: 0;
    background: none;
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hf-limpiar {
    text-decoration: underline;
    text-decoration-color: var(--shu);
    text-underline-offset: 0.25em;
  }
  .hf-grupo {
    display: grid;
    gap: 0.5rem;
  }
  .hf-grupo > .mono {
    font-size: 0.6rem;
    color: var(--ink-soft);
  }
  .hf-opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.45rem;
  }
  .hf .ficha {
    height: 2.4rem;
    font-size: 0.7rem;
  }
  .hf-pie {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--ink);
  }
  .hf-ver {
    flex: 1;
    height: 3rem;
    border: 0;
    border-radius: 3px;
    background: var(--shu-tinta);
    color: var(--paper);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .hf-ver:disabled {
    background: var(--ink-soft);
    cursor: default;
  }
  .total {
    line-height: 1;
    /* la mono se ve un pelo alta frente al texto de los botones */
    position: relative;
    top: 1px;
    color: var(--ink-soft);
    margin-left: 0.25rem;
    white-space: nowrap;
  }
  .total b {
    color: var(--ink);
    font-weight: 500;
  }
  .proponer {
    margin-left: auto;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--shu-tinta);
    color: var(--paper);
    border: 0;
    border-radius: 99px;
    padding: 0 0.9rem;
  }
  .proponer:hover {
    background: var(--ink);
  }
  .proponer {
    background: var(--shu-tinta);
    color: var(--paper);
    border: 0;
  }
  .filtros-cel .proponer {
    flex: none;
  }
  :global([data-sesion='no']) .solo-mios {
    display: none;
  }

  .vacio {
    padding-block: 3rem;
    max-width: none;
    font-family: var(--f-display);
    font-size: 1.4rem;
  }
  .vacio button {
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-decoration-color: var(--shu);
    text-underline-offset: 0.2em;
  }

  /* ───── tema ───── */
  .tema {
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter);
    border-bottom: 1px solid var(--ink);
    scroll-margin-top: 5.5rem;
  }
  .tema > header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    margin-bottom: 1.5rem;
  }
  .k {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 0.85;
    color: var(--shu);
  }
  .tema h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
  }
  .tema > header p {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
  }
  .cuenta {
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* ───── tarjetas ───── */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }
  .lugar {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    scroll-margin-top: 6rem;
  }
  .lugar[hidden] {
    display: none;
  }
  .lugar:target {
    outline: 3px solid var(--shu);
    outline-offset: -3px;
  }

  .foto {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-2);
    border-bottom: 1px solid var(--ink);
  }
  /* impresa en el papel, a una tinta… */
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
    transition: filter 0.45s;
  }
  /* El tono del papel va en una capa encima, y no como modo de mezcla de la foto: un modo de
     mezcla no se puede animar y saltaba de golpe. La opacidad sí, así que el papel se desvanece
     al mismo ritmo que el gris y todo el paso es un solo movimiento. */
  .foto {
    isolation: isolate;
  }
  .foto:has(img)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--paper-2);
    mix-blend-mode: multiply;
    pointer-events: none;
    transition: opacity 0.45s;
  }
  .cuando,
  .sello-anime {
    z-index: 2;
  }
  /* …y a color cuando lleva mi sello (o al pasar el cursor) */
  .lugar:has(.poner[aria-pressed='true']) .foto {
    & img {
      filter: none;
    }
    &::before {
      opacity: 0;
    }
  }
  @media (hover: hover) {
    .lugar:hover .foto {
      & img {
        filter: none;
      }
      &::before {
        opacity: 0;
      }
    }
  }
  /* En el celular no hay cursor: se prende la foto que pasa por el centro de la pantalla */
  @media (hover: none) {
    .lugar.a-la-vista .foto {
      & img {
        filter: none;
      }
      &::before {
        opacity: 0;
      }
    }
  }
  .sin-foto {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 6rem;
    line-height: 1;
    color: var(--ink);
    opacity: 0.1;
  }
  .cuando {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.25rem 0.6rem;
    background: var(--shu-tinta);
    color: var(--paper);
    font-size: 0.62rem;
  }

  /* sello de escenas de anime: arriba a la izquierda (abajo va la temporada). Cuerpo negro con anillo
     de papel: el anillo se separa de las fotos oscuras y el negro de las claras. Solo avisa: no se toca */
  .sello-anime {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 0 0 2px var(--paper);
    font-family: var(--f-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }
  .sello-anime b {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0;
  }

  .cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem 0.3rem;
  }
  /* «Sale en: …» va al fondo del texto, justo encima de «Quiero ir»: queda a la misma altura en
     toda la fila aunque las descripciones midan distinto */
  .linea-anime {
    margin: auto 0 0;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--hair);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .cuerpo:has(.linea-anime) > :nth-last-child(2) {
    margin-bottom: 0.65rem;
  }
  .linea-anime .marca {
    margin-right: 0.3rem;
    font-family: var(--f-display);
    font-weight: 800;
    color: var(--shu);
  }
  .linea-anime em {
    font-family: var(--f-display);
    font-weight: 700;
  }
  .linea-anime .suave {
    color: var(--ink-soft);
  }
  /* 44 px para el dedo sin mover el renglón */
  .ver-escenas {
    display: inline-block;
    padding: 0.8rem 0;
    margin-block: -0.8rem;
    background: none;
    border: 0;
    font: inherit;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--shu);
    text-underline-offset: 0.2em;
  }
  .ver-escenas:hover {
    color: var(--shu-tinta);
  }
  .linea-anime .aparte {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .linea-anime .aparte::before {
    content: '↳ ';
    color: var(--shu-tinta);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.62rem;
    color: var(--ink-soft);
  }
  .meta a {
    text-decoration: none;
    white-space: nowrap;
  }
  .lugar h3 {
    font-size: 1.3rem;
    line-height: 1.15;
    margin-top: 0.4rem;
  }
  /* el nombre lleva a leer sobre el lugar: quieto se ve como título, con la flechita de
     «sale del sitio» que usan todos los enlaces de afuera; al pasar se subraya en bermellón */
  .leer {
    text-decoration: none;
    /* agranda la zona de toque en celular sin mover el renglón (en línea no empuja nada) */
    padding-block: 0.2em;
  }
  .leer:hover {
    color: inherit;
  }
  .leer span {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s;
  }
  .leer:hover span,
  .leer:focus-visible span {
    text-decoration-color: var(--shu);
  }
  /* el espacio duro la amarra a la última palabra: nunca queda sola en otro renglón */
  .leer::after {
    content: '\00a0↗' / '';
    font-family: var(--f-mono);
    font-weight: 400;
    font-size: 0.6em;
    vertical-align: 0.35em;
    color: var(--ink-soft);
  }
  .leer:hover::after,
  .leer:focus-visible::after {
    color: var(--shu-tinta);
  }
  .jp {
    margin: 0.2rem 0 0;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .desc {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .propuso {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    font-size: 0.62rem;
    color: var(--ink-soft);
    min-height: 2.5rem;
  }
  .propuso button {
    margin-left: auto;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .propuso button:hover,
  .propuso button.seguro {
    color: var(--shu-tinta);
  }
  .pie {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem 0.85rem;
  }
  /* el ✓ de «marcado» ensancha el botón: se le reserva ese ancho para que mi sello
     no corra los sellos de los demás (igual que en las ventanas de «Cuándo ir») */
  .pie .poner {
    min-width: 6.7rem;
    text-align: left;
  }
  /* Los sellos van siempre en un solo renglón: si no caben a su paso normal se montan más,
     en vez de bajar a un segundo renglón que haría crecer la tarjeta (pasaba en celular
     del cuarto sello en adelante). Cada sello ocupa un carril de máximo 1.35rem y se sale
     de él hacia la derecha; el relleno guarda el ancho del último. */
  .pie .juntos {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1.35rem);
    justify-content: start;
    padding-right: 1.6rem;
    margin-right: -1rem;
  }
  .pie .juntos :global(.sello-p + .sello-p) {
    margin-left: 0;
  }

  .nueva {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    min-height: 9rem;
    padding: 1rem;
    border: 0;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: repeating-linear-gradient(-45deg, transparent 0 7px, var(--hair) 7px 8px);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .nueva span {
    font-size: 1.6rem;
    line-height: 1;
    color: var(--shu);
  }
  .nueva:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .novedad {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    padding: 0.7rem 1.1rem;
    border: 0;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 4px 4px 0 var(--shu);
  }
  .novedad[hidden] {
    display: none;
  }

  /* proponer en celular: a la mano del pulgar, con la misma sombra dura del aviso y los diálogos */
  .flotante {
    display: none;
  }
  @media (max-width: 720px) {
    .filtros-cel .proponer {
      display: none;
    }
    .flotante {
      position: fixed;
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      z-index: 30;
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      padding: 0;
      border: 1px solid var(--ink);
      border-radius: 50%;
      background: var(--shu);
      color: var(--paper);
      box-shadow: 4px 4px 0 var(--ink);
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.12s, box-shadow 0.12s;
    }
    /* al tocarlo se hunde como un sello contra el papel */
    .flotante:active {
      transform: translate(3px, 3px);
      box-shadow: 1px 1px 0 var(--ink);
    }
    /* el aviso de lugares nuevos se apila encima, sin tapar el botón */
    .novedad {
      bottom: calc(1rem + 3.5rem + 0.9rem + env(safe-area-inset-bottom));
    }
    /* el final de la página nunca queda debajo del botón */
    :global(body) {
      padding-bottom: 5rem;
    }
  }

  /* ───── créditos ───── */
  .creditos summary {
    cursor: pointer;
  }
  .creditos ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    columns: 2 22rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .creditos li {
    padding: 0.15rem 0;
    break-inside: avoid;
  }

  /* ───── formulario ───── */
  .dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  #proponer select,
  #proponer textarea {
    font: inherit;
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    width: 100%;
    resize: vertical;
  }
  #proponer select:focus,
  #proponer textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--shu);
  }
  #proponer h2 {
    font-size: 1.9rem;
  }

  @media (max-width: 720px) {
    .total {
      display: none;
    }
    .tema > header {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .cuenta {
      display: none;
    }
    /* tarjeta acostada: foto a la izquierda, texto a la derecha, sello abajo */
    .rejilla {
      grid-template-columns: 1fr;
    }
    .lugar {
      display: grid;
      grid-template-columns: 36% 1fr;
    }
    .foto {
      aspect-ratio: auto;
      min-height: 8.5rem;
      border-bottom: 0;
      border-right: 1px solid var(--ink);

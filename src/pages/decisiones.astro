          </ul>
        ) : (
          <p class="vacio">Nadie tiene un plan solo suyo todavía.</p>
        )
      }
    </div>
  </section>

  <!-- ───── 03 · papeles ───── -->
  <section class="sec" aria-labelledby="papeles-t">
    <header>
      <span class="mono">03 · Papeles</span>
      <h2 id="papeles-t">Qué tan listos estamos</h2>
      <p class="quorum">

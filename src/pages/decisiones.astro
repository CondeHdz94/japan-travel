---
import Base from '../layouts/Base.astro';
import Sello from '../components/Sello.astro';
import { SEMILLAS, TEMAS, ZONAS, type Lugar } from '../data/lugares';
import { VENTANAS_VIAJE } from '../data/ventanas';
import creditos from '../data/fotos.json';
import { estado } from '../lib/db';
import { propuestos, type LugarPropuesto } from '../lib/lugares';
import { sesion } from '../lib/sesion';
import { iniciales } from '../scripts/sello';
import {
  contarLugares,
  contarMeses,
  contarPapeles,
  contarVentanas,
  lider,
  MESES_DE_VENTANA,
  miParte,
  noCuadran,
  papelUrgente,
  quorum,
  repartirDias,
  temprano,
  type Marca,
  type Persona,
} from '../lib/decisiones';

// Se arma en el servidor en cada visita, con los votos del momento: no se actualiza en vivo.
// Sin sesión no se ve nada del grupo (ni nombres ni votos), solo cómo se cuenta.
export const prerender = false;
Astro.response.headers.set('cache-control', 'private, no-store');

const yoId = sesion(Astro.cookies);
let personas: Persona[] = [];
let marcas: Marca[] = [];
let delGrupo: LugarPropuesto[] = [];
let yo: Persona | null = null;
if (yoId) {
  const [e, ls] = await Promise.all([estado(yoId), propuestos()]);
  yo = e.yo;
  personas = e.personas;
  marcas = e.marcas;
  delGrupo = ls;
}
const ini = iniciales(personas);
const sello = (p: Persona) => ({ persona: p, ini: ini.get(p.id) ?? '?' });

// ───── las cuentas ─────
const n = personas.length;
const ventanas = contarVentanas(personas, marcas);
const { primera, empatadas, siFalla, todasTachadas } = lider(ventanas);
const qVentanas = quorum(personas, marcas, 'ventana');
const qLugares = quorum(personas, marcas, 'lugar');
// con menos de la mitad del grupo votando no se anuncia ganadora
const esTemprano = temprano(qVentanas.votaron.length, n);
const ganadora = esTemprano ? null : primera;
const meses = contarMeses(personas, marcas);
// lo que no cuadra, una fila por persona
const sueltos = noCuadran(personas, marcas);
const raros = personas
  .map((p) => ({ persona: p, votos: sueltos.filter((r) => r.persona.id === p.id) }))
  .filter((x) => x.votos.length > 0);
const catalogo: Lugar[] = [...SEMILLAS, ...delGrupo];
// la temporada se compara con la que va adelante; si hay empate o es temprano, con ninguna
const contraVentana = ganadora && !empatadas.length ? ganadora.id : null;
const lugares = contarLugares(personas, marcas, catalogo, contraVentana);
const DIAS = 15;
const conVotos = [...lugares.fijos, ...lugares.fuerza];
const reparto = repartirDias(conVotos, DIAS);
const papeles = contarPapeles(personas, marcas);
const totalConVotos = conVotos.length + lugares.personales.reduce((s, x) => s + x.lugares.length, 0);
// si a la que va adelante le falta mi voto, el aviso me habla a mí
const faltoYo = !!primera?.faltan.some((p) => p.id === yo?.id);
const otrosFaltan = primera?.faltan.filter((p) => p.id !== yo?.id) ?? [];
// lo que va adelante (una, o varias si van empatadas): lo único bermellón de la tabla y la franja
const delante = new Set(esTemprano ? [] : empatadas.length ? empatadas.map((x) => x.id) : primera ? [primera.id] : []);
const mia = yo ? miParte(yo, personas, marcas) : null;

// ───── textos ─────
const V = Object.fromEntries(VENTANAS_VIAJE.map((v) => [v.id, { ...v, k: v.kanji }]));
// en la franja de meses: dos carriles, porque Abril tardío se monta sobre Cerezos
const carril: Record<string, number> = { cerezos: 1, abril: 2, primavera: 1, verano: 1, otono: 1, invierno: 1 };
const MES = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
const MES_LARGO = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const VOTO = { 2: { k: '好', t: 'Me encanta' }, 1: { k: '可', t: 'Me sirve' }, 0: { k: '否', t: 'No puedo' } } as const;
const ZONA = Object.fromEntries(ZONAS.map((z) => [z.id, z.nombre]));
const KANJI_ZONA: Record<string, string> = { tokio: '東京', kanto: '関東', chubu: '中部', kansai: '関西', oeste: '西', norte: '北', sur: '南' };
const PAPEL: Record<string, string> = {
  pasaporte: 'Pasaporte',
  visa: 'Visa japonesa',
  tiquetes: 'Tiquetes',
  hospedajes: 'Hospedajes',
  seguro: 'Seguro de viaje',
  vjw: 'Visit Japan Web',
  plata: 'Plata',
};

const y = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} y ${xs.at(-1)}`);
const nombres = (ps: Persona[]) => y(ps.map((p) => p.nombre));
const o = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} ni ${xs.at(-1)}`);
const dos = (x: number) => String(x).padStart(2, '0');
const plural = (k: number, uno: string, varios: string) => `${k} ${k === 1 ? uno : varios}`;
// cuando la lista me incluye, la página me habla a mí: «Andrés y tú», «faltas tú»
const esYo = (p: Persona) => p.id === yo?.id;
const conTu = (ps: Persona[]) => {
  const otros = ps.filter((p) => !esYo(p)).map((p) => p.nombre);
  return ps.some(esYo) ? (otros.length ? y([...otros, 'tú']) : 'tú') : y(otros);
};
const mayuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const faltan = (ps: Persona[]) =>
  ps.length === 1 && esYo(ps[0]) ? 'faltas tú' : `${ps.length === 1 ? 'falta' : 'faltan'} ${conTu(ps)}`;

// completo es quien votó ventanas, marcó meses y votó lugares
const completos = personas.filter(
  (p) => !qVentanas.faltan.includes(p) && !meses.faltan.includes(p) && !qLugares.faltan.includes(p),
);
const pendientes = personas.filter((p) => !completos.includes(p));
const urgente = papelUrgente(papeles);
// lo que me falta, dicho con su artículo: «te falta la visa», «te faltan los tiquetes»
const TE_FALTA: Record<string, string> = {
  pasaporte: 'Te falta el pasaporte',
  visa: 'Te falta la visa japonesa',
  tiquetes: 'Te faltan los tiquetes',
  hospedajes: 'Te faltan los hospedajes',
  seguro: 'Te falta el seguro de viaje',
  vjw: 'Te falta el registro en Visit Japan Web',
  plata: 'Te falta tener lista la plata',
};

// el acta: qué va en la casilla de Cuándo
const cuando = esTemprano
  ? { v: '—', s: `es temprano · votaron ${qVentanas.votaron.length} de ${n}` }
  : empatadas.length
    ? { v: 'Empate', s: y(empatadas.map((x) => V[x.id].corto)) }
    : primera
      ? { v: V[primera.id].corto, s: primera.faltan.length ? `va adelante · falta${primera.faltan.length === 1 ? '' : 'n'} ${primera.faltan.length}` : 'va adelante' }
      : todasTachadas
        ? { v: 'Ninguna', s: 'todas tienen un «No puedo»' }
        : { v: '—', s: 'nadie ha votado' };

// mis pendientes, en el orden en que conviene hacerlos
const pendientesMios = mia
  ? [
      mia.decido && {
        clave: 'decido',
        texto: mia.decido.siNo
          ? `Tu voto decide: si pones «No puedo» en ${V[mia.decido.ventana].corto}, pasa adelante ${V[mia.decido.siNo].nombre}.`
          : `Tu voto decide: si pones «No puedo» en ${V[mia.decido.ventana].corto}, no queda ninguna ventana en pie.`,
        href: '/cuando-ir',
      },
      mia.ventanas.filter((v) => v !== mia.decido?.ventana).length > 0 && {
        clave: 'ventanas',
        texto:
          mia.ventanas.length === VENTANAS_VIAJE.length && !mia.decido
            ? 'No has votado ninguna ventana.'
            : `Te falta votar ${y(mia.ventanas.filter((v) => v !== mia.decido?.ventana).map((v) => V[v].nombre))}.`,
        href: '/cuando-ir',
      },
      mia.meses && { clave: 'meses', texto: 'No has marcado en qué meses puedes viajar.', href: '/cuando-ir' },
      mia.lugares && { clave: 'lugares', texto: 'No has votado ningún lugar.', href: '/lugares' },
      mia.papel && { clave: 'papel', texto:
          mia.papel === 'pasaporte'
            ? `${TE_FALTA.pasaporte}: sin él no se puede pedir la visa.`
            : `${TE_FALTA[mia.papel]}: otros del grupo ya van en eso.`, href: '/requisitos' },
    ].filter((x): x is { clave: string; texto: string; href: string } => !!x)
  : [];

// días de cada zona, para la franja
let dia = 1;
const tramos = reparto.map((z) => {
  const t = { ...z, desde: dia, hasta: dia + z.dias - 1 };
  dia += z.dias;
  return t;
});
const fotos = creditos as Record<string, { archivo: string }>;
const foto = (l: Lugar) =>
  (l as LugarPropuesto).imagen ?? (fotos[l.id] ? `/lugares/${fotos[l.id].archivo}` : undefined);
const kanjiTema = (l: Lugar) => TEMAS.find((t) => t.id === l.tema)?.kanji ?? '所';
const temporadaDe = (c: { temporada: 'si' | 'no' | null }) =>
  c.temporada === 'si' ? 'De temporada' : c.temporada === 'no' ? `No da en ${V[contraVentana!].corto.toLowerCase()}` : null;
---

<Base title="Decisiones" description="Los votos del grupo, puestos juntos para decidir.">
  <header class="page-head">
    <span class="kanji" aria-hidden="true">決</span>
    <div>
      <span class="mono">04 · kime · lo que vamos decidiendo</span>
      <h1>Decisiones</h1>
      <p>
        Los votos de todos, puestos juntos: qué va ganando, qué está trabado y qué falta para
        decidir. Nada está cerrado todavía: esto cambia cada vez que alguien vota.
      </p>
    </div>
  </header>

  {
    !yo && (
      <section class="sin-sesion wrap">
        <p>
          <span>Lo que va decidiendo el grupo solo se ve con sesión.</span>{' '}
          <button type="button" data-entrar>Entra con tu nombre →</button>
        </p>
      </section>
    )
  }

  {
    yo && (
      <>
  <!-- el acta: lo que va, de un vistazo -->
  <dl class="acta">
    <div>
      <dt class="mono">Cuándo</dt>
      <dd>
        <strong>{cuando.v}</strong>
        <span>{cuando.s}</span>
      </dd>
    </div>
    <div>
      <dt class="mono">Lugares</dt>
      <dd>
        <strong>{plural(lugares.fijos.length, 'fijo', 'fijos')}</strong>
        <span>de {totalConVotos} con votos</span>
      </dd>
    </div>
    <div>
      <dt class="mono">Zonas</dt>
      <dd>
        <strong>{reparto.length ? plural(reparto.length, 'zona', 'zonas') : '—'}</strong>
        <span>{reparto.length ? 'posible ruta' : 'faltan votos en común'}</span>
      </dd>
    </div>
    <div>
      <dt class="mono">{urgente ? PAPEL[urgente.id] : 'Papeles'}</dt>
      <dd>
        <strong>{urgente ? `${urgente.tienen.length} de ${n}` : 'Listos'}</strong>
        <span>{urgente ? (urgente.tienen.length === 1 ? 'ya lo tiene' : 'ya lo tienen') : 'todos, todo'}</span>
      </dd>
    </div>
    <div>
      <dt class="mono">Votaron en todo</dt>
      <dd>
        <span class="fila-sellos juntos" aria-label={pendientes.length ? `Completos: ${nombres(completos) || 'nadie'}. Faltan: ${nombres(pendientes)}` : 'Votaron todos'}>
          {completos.map((p) => <Sello {...sello(p)} clave="acta" />)}
          {pendientes.map((p) => <Sello {...sello(p)} fantasma clave="acta" />)}
        </span>
        <span>{pendientes.length ? `${completos.length} de ${n} · ${faltan(pendientes)}` : 'todos, sin falta'}</span>
      </dd>
    </div>
  </dl>

  <!-- lo que me toca a mí: cada pendiente lleva a donde se hace -->
  <section class="tu-parte wrap" aria-labelledby="tu-parte-t">
    <h2 id="tu-parte-t" class="mono">Tu parte</h2>
    {
      pendientesMios.length ? (
        <ul>
          {pendientesMios.map((x) => (
            <li class:list={{ decide: x.clave === 'decido' }} data-pendiente={x.clave}>
              <a href={x.href}>
                <span>{x.texto}</span>
                <span class="ir" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p data-pendiente="nada">Ya votaste en todo. Lo que falta es de los demás.</p>
      )
    }
  </section>

  <!-- ───── 01 · cuándo ───── -->
  <section class="sec" aria-labelledby="cuando-t">
    <header>
      <span class="mono">01 · Cuándo</span>
      <h2 id="cuando-t">La ventana que va ganando</h2>
      <p class="quorum">
        Votaron {qVentanas.votaron.length} de {n}.{' '}
        <a href="/cuando-ir">Ir a votar →</a>
      </p>
    </header>

    <div class="cuerpo">
      {
        esTemprano ? (
          <p class="ojo veredicto-vacio" data-veredicto="temprano">
            <span class="mono">Es temprano</span>
            <span>
              Votaron {qVentanas.votaron.length} de {n}: con menos de la mitad del grupo no se anuncia
              ganadora. {qVentanas.faltan.length > 0 && <>{mayuscula(faltan(qVentanas.faltan))}.</>}
            </span>
          </p>
        ) : empatadas.length ? (
          <div class="veredicto" data-veredicto="empate">
            <span class="estacion" lang="ja" aria-hidden="true">{empatadas.map((x) => V[x.id].k).join('')}</span>
            <div>
              <p class="mono va">Van empatadas</p>
              <h3>{y(empatadas.map((x) => V[x.id].nombre))}</h3>
              <p class="dice">
                {empatadas[0].puntos} puntos cada una, y nadie ha dicho que no puede. Los votos que
                faltan las desempatan.
              </p>
            </div>
          </div>
        ) : primera ? (
          <div class="veredicto" data-veredicto="primera">
            <span class="estacion" lang="ja" aria-hidden="true">{V[primera.id].k}</span>
            <div>
              <p class="mono va">Va adelante</p>
              <h3>{V[primera.id].nombre}</h3>
              <p class="mono fechas">{V[primera.id].fechas}</p>
              <p class="dice">
                {primera.puntos} de {2 * (n - primera.faltan.length)} puntos posibles, y nadie ha
                dicho que no puede.
              </p>
            </div>
            {primera.faltan.length > 0 && (
              <p class="ojo">
                <span class="mono">Ojo</span>
                <span>
                  {faltoYo ? (
                    otrosFaltan.length ? <>Falta tu voto y el de <b>{nombres(otrosFaltan)}</b>. Si alguno pone «No puedo»,{' '}</> : <>Falta tu voto. Si pones «No puedo»,{' '}</>
                  ) : (
                    <>Falta el voto de <b>{nombres(primera.faltan)}</b>. Si {primera.faltan.length === 1 ? 'pone' : 'alguno pone'} «No puedo»,{' '}</>
                  )}
                  {V[primera.id].corto} queda tachada
                  {siFalla ? <> y pasa adelante <b>{V[siFalla.id].nombre}</b>.</> : ' y no queda ninguna en pie.'}
                </span>
              </p>
            )}
          </div>
        ) : (
          <p class="ojo veredicto-vacio" data-veredicto={todasTachadas ? 'ninguna' : 'nada'}>
            <span class="mono">{todasTachadas ? 'Ninguna' : 'Sin votos'}</span>
            <span>
              {todasTachadas
                ? 'Todas las ventanas con votos tienen un «No puedo». Toca revisar esos votos o buscar otra fecha.'
                : 'Nadie ha votado ventanas todavía.'}
            </span>
          </p>
        )
      }

      <h3 class="sub">Tabla de posiciones</h3>
      <p class="mono regla">
        <span lang="ja">好</span> 2 puntos · <span lang="ja">可</span> 1 · un solo <span lang="ja">否</span> tacha la ventana: tenemos que poder todos
      </p>
      <div class="tabla" role="table" aria-label="Ventanas por puntos">
        <div class="fila cabeza mono" role="row">
          <span role="columnheader">N.º</span>
          <span role="columnheader">Ventana</span>
          <span role="columnheader"><b lang="ja">好</b> Me encanta</span>
          <span role="columnheader"><b lang="ja">可</b> Me sirve</span>
          <span role="columnheader"><b lang="ja">否</b> No puedo</span>
          <span role="columnheader">Falta</span>
          <span role="columnheader">Puntos</span>
        </div>
        {
          ventanas.map((v, i) => (
            <div class:list={['fila', { primera: delante.has(v.id), tachada: v.tachada, 'sin-votos': v.faltan.length === n }]} role="row">
              <span class="pos mono" role="cell">{v.tachada || v.faltan.length === n ? '—' : dos(i + 1)}</span>
              <span class="nombre" role="cell">
                <span class="mini-estacion" lang="ja" aria-hidden="true">{V[v.id].k}</span>
                <span>
                  <strong>{V[v.id].nombre}</strong>
                  <span class="mono">{V[v.id].fechas}</span>
                  {v.tachada && (
                    <span class="veto mono">
                      {/* con muchos, la cuenta: quiénes son ya se ve en sus sellos de la columna 否 */}
                      {v.votos[0].length === n && n > 1
                        ? 'Nadie puede'
                        : v.votos[0].length > 2
                          ? `No pueden ${v.votos[0].length}`
                          : v.votos[0].length === 1 && esYo(v.votos[0][0])
                            ? 'No puedes tú'
                            : `No puede${v.votos[0].length > 1 ? 'n' : ''}: ${conTu(v.votos[0])}`}
                    </span>
                  )}
                </span>
              </span>
              <span class="celdas">
                {([2, 1, 0] as const).map((val) => (
                  <span class:list={['celda', `v${val}`]} role="cell">
                    <b class="etq" lang="ja" aria-hidden="true">{VOTO[val].k}</b>
                    <span class="solo-lector">{VOTO[val].t}: {nombres(v.votos[val]) || 'nadie'}</span>
                    <span class="fila-sellos juntos" aria-hidden="true">
                      {v.votos[val].map((p) => <Sello {...sello(p)} clave={`${v.id}:${val}`} />)}
                    </span>
                  </span>
                ))}
                <span class="celda falta" role="cell">
                  <b class="etq mono" aria-hidden="true">Falta</b>
                  <span class="solo-lector">Falta: {nombres(v.faltan) || 'nadie'}</span>
                  <span class="fila-sellos juntos" aria-hidden="true">
                    {v.faltan.map((p) => <Sello {...sello(p)} fantasma clave={`${v.id}:f`} />)}
                  </span>
                </span>
              </span>
              <span class="puntos" role="cell">
                <span class="medidor" aria-hidden="true">
                  {Array.from({ length: v.tope }, (_, k) => (
                    <i
                      class:list={{
                        lleno: k < v.puntos,
                        posible: k >= v.puntos && k < v.puntos + 2 * v.faltan.length,
                      }}
                    />
                  ))}
                </span>
                {v.faltan.length === n ? (
                  <span class="cifra">
                    <span class="mono">Sin votos</span>
                  </span>
                ) : (
                  <span class="cifra">
                    <b>{v.puntos}</b>
                    <span class="mono">de {2 * (n - v.faltan.length)}</span>
                  </span>
                )}
              </span>
            </div>
          ))
        }
      </div>
      <p class="mono leyenda">
        <span><i class="seg lleno"></i> Puntos</span>
        <span><i class="seg posible"></i> Los que pueden llegar</span>
        <span><i class="seg"></i> Perdidos</span>
      </p>

      <h3 class="sub">¿Qué meses podemos todos?</h3>
      <p class="nota">
        Cruce de los «Puedo» de cada uno con las seis ventanas. En gris, los meses en que pueden
        todos los que ya marcaron.
      </p>
      <div class="meses-grupo" style={`--filas:${n}`} role="img" aria-label={`Meses en que pueden todos los que marcaron: ${MES_LARGO.filter((_, i) => meses.todos[i]).join(', ')}`}>
        {meses.todos.map((t, i) => t && <span class="todos" style={`--m:${i + 1}`} />)}
        {Object.entries(MESES_DE_VENTANA).map(([id, ms]) => (
          <span
            class:list={['banda', { primera: delante.has(id), tachada: ventanas.find((v) => v.id === id)?.tachada }]}
            style={`--desde:${Math.min(...ms)};--hasta:${Math.max(...ms)};--carril:${carril[id]}`}
          >
            <span class="txt">{V[id].corto}</span>
            <span class="bk" lang="ja" aria-hidden="true">{V[id].k}</span>
          </span>
        ))}
        {MES.map((m, i) => (
          <span class="mes mono" style={`--m:${i + 1}`}>{m}</span>
        ))}
        {personas.map((p, f) => (
          <>
            <span class="quien-es" style={`--f:${f + 1}`}>
              <Sello {...sello(p)} fantasma={!meses.puede.has(p.id)} clave="meses" />
            </span>
            {MES.map((_, i) => (
              <span
                class:list={['casilla', { si: meses.puede.get(p.id)?.has(i + 1), sin: !meses.puede.has(p.id) }]}
                style={`--m:${i + 1};--f:${f + 1}`}
              />
            ))}
          </>
        ))}
        {meses.porMes.map((c, i) => (
          <span class:list={['cuenta mono', { 'es-todos': meses.todos[i] }]} style={`--m:${i + 1}`}>
            {c}
          </span>
        ))}
      </div>
      {meses.faltan.length > 0 && (
        <p class="mono pendiente">
          {meses.faltan.length === 1 && esYo(meses.faltan[0])
            ? 'Todavía no has marcado meses.'
            : `${conTu(meses.faltan)} todavía no ${meses.faltan.length === 1 ? 'ha' : 'han'} marcado meses.`}
        </p>
      )}

      {
        raros.length > 0 && (
          <div class="no-cuadra">
            <h3 class="sub">No cuadra</h3>
            <p class="nota">Votos a una ventana sin ninguno de sus meses marcado: o falta un «Puedo», o sobra el voto.</p>
            <ul>
              {raros.map(({ persona, votos }) => (
                <li>
                  <Sello {...sello(persona)} clave="raro" />
                  <span>
                    <b>{esYo(persona) ? 'Tú' : persona.nombre}</b> {esYo(persona) ? 'votaste' : 'votó'} por{' '}
                    {y(votos.map((r) => V[r.ventana].nombre))}, pero no {esYo(persona) ? 'marcaste' : 'marcó'} {o([...new Set(votos.flatMap((r) => r.meses))].sort((a, b) => a - b).map((m) => MES_LARGO[m - 1]))}.
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- ───── 02 · lugares ───── -->
  <section class="sec" aria-labelledby="lugares-t">
    <header>
      <span class="mono">02 · Lugares</span>
      <h2 id="lugares-t">Lo que vamos a ver</h2>
      <p class="quorum">
        Votaron {qLugares.votaron.length} de {n}.{' '}
        <a href="/lugares">Ir a votar →</a>
      </p>
    </header>

    <div class="cuerpo">
      <div class="grupo-lugares idea">
        <h3 class="sub">Una forma de repartir los {DIAS} días</h3>
        <p class="mono umbral">Posible opción · no es fija</p>
      </div>
      {
        tramos.length ? (
          <>
            <p class="nota">
              Sale de los votos de lo que quieren dos o más
              {contraVentana && `, y solo de lo que se da en ${V[contraVentana].corto.toLowerCase()}`}. Es para hacerse
              una idea de cuánto pesa cada zona, no un plan: no cuenta vuelos ni trayectos, y la ruta de verdad se
              arma en el Itinerario.
            </p>
            <div class="dias" style={`--dias:${DIAS}`}>
              <ol class="numeros mono" aria-hidden="true">
                {Array.from({ length: DIAS }, (_, i) => <li>{i + 1}</li>)}
              </ol>
              <ol class="tramos">
                {tramos.map((t) => (
                  <li style={`--desde:${t.desde};--hasta:${t.hasta}`} aria-label={`${ZONA[t.zona]}: ${plural(t.dias, 'día', 'días')}`}>
                    <span class="k" lang="ja" aria-hidden="true">{KANJI_ZONA[t.zona]}</span>
                  </li>
                ))}
              </ol>
            </div>
            <ul class="zonas">
              {tramos.map((t) => (
                <li>
                  <span class="k" lang="ja" aria-hidden="true">{KANJI_ZONA[t.zona]}</span>
                  <span>
                    <strong>{ZONA[t.zona]}</strong>
                    <span class="mono">
                      {plural(t.dias, 'día', 'días')} · {t.desde === t.hasta ? `día ${t.desde}` : `días ${t.desde}–${t.hasta}`}
                    </span>
                    <span class="por">{t.lugares.map((c) => c.lugar.nombre).join(' · ')}</span>
                  </span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="vacio">
            Cuando al menos dos personas quieran ir al mismo sitio, aquí sale cuánto pesa cada zona en los
            {DIAS} días.
          </p>
        )
      }

      {
        contraVentana && lugares.fueraDeFecha.length > 0 && (
          <p class="ojo">
            <span class="mono">Si es {V[contraVentana].corto.toLowerCase()}</span>
            <span>
              {lugares.fueraDeFecha.length === 1
                ? 'Se cae uno que tiene votos, porque no se da en esas fechas: '
                : `Se caen ${lugares.fueraDeFecha.length} que tienen votos, porque no se dan en esas fechas: `}
              {y(lugares.fueraDeFecha.map((c) => `${c.lugar.nombre} (${c.quieren.length})`))}.
            </span>
          </p>
        )
      }

      <div class="grupo-lugares">
        <h3 class="sub">Fijos</h3>
        <p class="mono umbral">
          {lugares.umbralFijo >= n ? 'Los quieren todos' : `Los quieren ${lugares.umbralFijo} o más`}
        </p>
      </div>
      {
        lugares.fijos.length ? (
          <ul class="fijos">
            {lugares.fijos.map((c) => (
              <li class:list={{ fuera: c.temporada === 'no' }} data-lugar={c.lugar.id}>
                <span class="foto">
                  {foto(c.lugar) ? (
                    <img src={foto(c.lugar)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="sin-foto" aria-hidden="true">{kanjiTema(c.lugar)}</span>
                  )}
                </span>
                <span class="txt">
                  <span class="mono zona">{ZONA[c.lugar.zona]}</span>
                  <a href={`/lugares#${c.lugar.id}`}>{c.lugar.nombre}</a>
                  {temporadaDe(c) && <span class:list={['chip', c.temporada === 'si' ? 'ok' : 'warn']}>{temporadaDe(c)}</span>}
                </span>
                <span class="votos">
                  <span class="fila-sellos juntos" aria-label={`Lo quieren ${nombres(c.quieren)}`}>
                    {c.quieren.map((p) => <Sello {...sello(p)} clave={c.lugar.id} />)}
                  </span>
                  <span class="mono">{c.quieren.length} de {n}</span>
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="vacio">Todavía no hay un lugar que quiera casi todo el grupo.</p>
        )
      }

      {
        lugares.umbralFijo > 2 && (
          <>
            <div class="grupo-lugares">
              <h3 class="sub">Con fuerza</h3>
              <p class="mono umbral">
                {lugares.umbralFijo - 1 === 2 ? 'Los quieren 2' : `Los quieren de 2 a ${lugares.umbralFijo - 1}`}
              </p>
            </div>
            {lugares.fuerza.length ? (
              <ul class="fuerza">
                {lugares.fuerza.map((c) => (

              {urgente.id === 'visa' && ' Sin visa no conviene comprar nada que no se pueda devolver.'}
            </span>
          ) : (
            <span>Todos tienen todos los papeles. A empacar.</span>
          )
        }
      </p>
      <div class="papeles" style={`--gente:${n}`} role="table" aria-label="Papeles listos por persona">
        <div class="fila cabeza" role="row">
          <span role="columnheader" class="mono">Papel</span>
          {personas.map((p) => (
            <span role="columnheader" class="persona">
              <span class="solo-lector">{p.nombre}</span>
              <span aria-hidden="true"><Sello {...sello(p)} clave="papeles" /></span>
            </span>
          ))}
          <span role="columnheader" class="mono cuantos">Listos</span>
        </div>
        {papeles.map((x) => (
          <div class:list={['fila', { urgente: x === urgente }]} role="row">
            <span role="rowheader" class="papel">{PAPEL[x.id]}</span>
            {personas.map((p) => (
              <span role="cell" class:list={['hueco', { listo: x.tienen.includes(p) }]}>
                <span class="solo-lector">{p.nombre}: {x.tienen.includes(p) ? 'listo' : 'pendiente'}</span>
                {x.tienen.includes(p) && (
                  <span aria-hidden="true"><Sello {...sello(p)} clave={`papel:${x.id}`} /></span>
                )}
              </span>
            ))}
            <span role="cell" class="mono cuantos">{x.tienen.length} de {n}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

      </>
    )
  }

  <section class="sec">
    <header>
      <span class="mono">Nota</span>
      <h2>Cómo se cuenta</h2>
    </header>
    <div class="reglas">
      <p>
        <b>Ventanas.</b> <span lang="ja">好</span> vale 2 puntos y <span lang="ja">可</span> vale 1. Se
        ordenan por puntos sobre lo posible entre quienes ya votaron, para que una ventana con votos
        pendientes no quede castigada. Un solo <span lang="ja">否</span> la tacha: no sirve una fecha
        en que alguien no puede ir.
      </p>
      <p>
        <b>Lugares.</b> Fijos son los que quiere todo el grupo o todos menos uno; con fuerza, los que
        quieren dos o más. Los días se reparten entre zonas en proporción a esos votos, y una zona que
        no alcanza a sumar un día completo no entra.
      </p>
      <p>
        <b>Temporada.</b> Si un lugar o evento solo se da en ciertos meses, se compara con la ventana
        que va adelante. Las fechas del catálogo están <b>por confirmar</b>.
      </p>
    </div>
  </section>
</Base>

